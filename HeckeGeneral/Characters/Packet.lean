import Mathlib.Analysis.Complex.Circle
import Mathlib.Topology.Algebra.ContinuousMonoidHom
import Mathlib.GroupTheory.OrderOfElement
import Mathlib.Tactic.Ext

/-!
# Continuous unitary character packets

The domain is an actual topological commutative group, and characters are continuous
homomorphisms into the unit circle.  A logarithmic norm is a continuous homomorphism
into `Multiplicative ℝ`; its associated twist is `exp (i * t * logNorm x)`.

For a fixed character `ω`, the packet consists of `θ * ω ^ e * normTwist logNorm t`,
where `θ` has finite order and `e` is one of `-1`, `0`, `1`.
No analytic property of an L-function is included in these definitions.

This file does not yet construct the idèle class group of a number field or its norm.
It supplies the character-theoretic lemmas that apply once those objects are provided.
-/

noncomputable section

namespace HeckeGeneral.Characters

variable {G : Type*} [CommGroup G] [TopologicalSpace G]

/-- A continuous unitary character, with unitarity encoded by the actual unit circle. -/
abbrev UnitaryCharacter (G : Type*) [CommGroup G] [TopologicalSpace G] := G →ₜ* Circle

/-- A continuous logarithmic norm, written multiplicatively on the domain. -/
abbrev LogNorm (G : Type*) [CommGroup G] [TopologicalSpace G] :=
  G →ₜ* Multiplicative ℝ

/-- Finite order in the character group, equivalently a common positive power is trivial. -/
abbrev FiniteOrder (χ : UnitaryCharacter G) : Prop := IsOfFinOrder χ

theorem finiteOrder_iff (χ : UnitaryCharacter G) :
    FiniteOrder χ ↔ ∃ n : ℕ, 0 < n ∧ χ ^ n = 1 :=
  isOfFinOrder_iff_pow_eq_one

/-- Finite order means a uniform exponent for all points of the domain. -/
theorem finiteOrder_iff_pointwise (χ : UnitaryCharacter G) :
    FiniteOrder χ ↔ ∃ n : ℕ, 0 < n ∧ ∀ x : G, (χ x) ^ n = 1 := by
  rw [finiteOrder_iff]
  constructor
  · rintro ⟨n, hn, hpow⟩
    refine ⟨n, hn, fun x => ?_⟩
    have hx := congrArg (fun ψ : UnitaryCharacter G => ψ x) hpow
    simpa using hx
  · rintro ⟨n, hn, hpow⟩
    refine ⟨n, hn, ?_⟩
    apply ContinuousMonoidHom.ext
    intro x
    simpa using hpow x

/-- The vertical unitary norm twist `x ↦ exp (i * t * logNorm x)`. -/
def normTwist (logNorm : LogNorm G) (t : ℝ) : UnitaryCharacter G where
  toFun x := Circle.exp (t * Multiplicative.toAdd (logNorm x))
  map_one' := by
    rw [map_one logNorm]
    simp
  map_mul' x y := by
    rw [map_mul logNorm]
    change Circle.exp (t * (Multiplicative.toAdd (logNorm x) +
      Multiplicative.toAdd (logNorm y))) = _
    rw [mul_add, Circle.exp_add]
  continuous_toFun := by
    have hlog : Continuous (fun x => Multiplicative.toAdd (logNorm x)) :=
      logNorm.continuous
    exact Circle.exp.continuous.comp (continuous_const.mul hlog)

@[simp] theorem normTwist_apply (logNorm : LogNorm G) (t : ℝ) (x : G) :
    normTwist logNorm t x = Circle.exp (t * Multiplicative.toAdd (logNorm x)) := rfl

@[simp] theorem normTwist_zero (logNorm : LogNorm G) : normTwist logNorm 0 = 1 := by
  apply ContinuousMonoidHom.ext
  intro x
  change Circle.exp (0 * Multiplicative.toAdd (logNorm x)) = 1
  simp

theorem normTwist_add (logNorm : LogNorm G) (t u : ℝ) :
    normTwist logNorm (t + u) = normTwist logNorm t * normTwist logNorm u := by
  apply ContinuousMonoidHom.ext
  intro x
  change Circle.exp ((t + u) * Multiplicative.toAdd (logNorm x)) =
    Circle.exp (t * Multiplicative.toAdd (logNorm x)) *
    Circle.exp (u * Multiplicative.toAdd (logNorm x))
  rw [add_mul, Circle.exp_add]

/-- The norm twists form a genuine one-parameter group of unitary characters. -/
def normTwistHom (logNorm : LogNorm G) : ℝ →+ Additive (UnitaryCharacter G) where
  toFun t := Additive.ofMul (normTwist logNorm t)
  map_zero' := normTwist_zero logNorm
  map_add' := normTwist_add logNorm

@[simp] theorem normTwist_neg (logNorm : LogNorm G) (t : ℝ) :
    normTwist logNorm (-t) = (normTwist logNorm t)⁻¹ := by
  apply ContinuousMonoidHom.ext
  intro x
  change Circle.exp ((-t) * Multiplicative.toAdd (logNorm x)) =
    (Circle.exp (t * Multiplicative.toAdd (logNorm x)))⁻¹
  rw [neg_mul, Circle.exp_neg]

/-- Complex conjugation of unitary characters is their inverse. -/
abbrev conjugate (χ : UnitaryCharacter G) : UnitaryCharacter G := χ⁻¹

theorem conjugate_apply (χ : UnitaryCharacter G) (x : G) :
    (conjugate χ x : ℂ) = star (χ x : ℂ) := by
  exact Circle.coe_inv_eq_conj (χ x)

theorem character_norm (χ : UnitaryCharacter G) (x : G) : ‖(χ x : ℂ)‖ = 1 :=
  Circle.norm_coe (χ x)

/-- The three possible powers of the fixed base character. -/
def PacketExponent (e : ℤ) : Prop := e = -1 ∨ e = 0 ∨ e = 1

theorem packetExponent_neg {e : ℤ} (he : PacketExponent e) : PacketExponent (-e) := by
  rcases he with h | h | h <;> simp [PacketExponent, h]

/-- The packet generated by a fixed character, all finite-order characters, and norm twists. -/
def Packet (logNorm : LogNorm G) (ω : UnitaryCharacter G) : Set (UnitaryCharacter G) :=
  {χ | ∃ (θ : UnitaryCharacter G), FiniteOrder θ ∧
    ∃ e : ℤ, PacketExponent e ∧
    ∃ t : ℝ, χ = θ * ω ^ e * normTwist logNorm t}

theorem finiteOrder_mem_packet (logNorm : LogNorm G) (ω θ : UnitaryCharacter G)
    (hθ : FiniteOrder θ) : θ ∈ Packet logNorm ω := by
  refine ⟨θ, hθ, 0, Or.inr (Or.inl rfl), 0, ?_⟩
  simp

theorem one_mem_packet (logNorm : LogNorm G) (ω : UnitaryCharacter G) :
    1 ∈ Packet logNorm ω :=
  finiteOrder_mem_packet logNorm ω 1 IsOfFinOrder.one

theorem base_mem_packet (logNorm : LogNorm G) (ω : UnitaryCharacter G) :
    ω ∈ Packet logNorm ω := by
  refine ⟨1, IsOfFinOrder.one, 1, Or.inr (Or.inr rfl), 0, ?_⟩
  simp

theorem normTwist_mem_packet (logNorm : LogNorm G) (ω : UnitaryCharacter G) (t : ℝ) :
    normTwist logNorm t ∈ Packet logNorm ω := by
  refine ⟨1, IsOfFinOrder.one, 0, Or.inr (Or.inl rfl), t, ?_⟩
  simp

theorem packet_mul_finiteOrder (logNorm : LogNorm G) (ω : UnitaryCharacter G)
    {χ ψ : UnitaryCharacter G} (hχ : χ ∈ Packet logNorm ω) (hψ : FiniteOrder ψ) :
    χ * ψ ∈ Packet logNorm ω := by
  rcases hχ with ⟨θ, hθ, e, he, t, rfl⟩
  refine ⟨θ * ψ, hθ.mul hψ, e, he, t, ?_⟩
  ac_rfl

theorem packet_inv (logNorm : LogNorm G) (ω : UnitaryCharacter G)
    {χ : UnitaryCharacter G} (hχ : χ ∈ Packet logNorm ω) :
    χ⁻¹ ∈ Packet logNorm ω := by
  rcases hχ with ⟨θ, hθ, e, he, t, rfl⟩
  refine ⟨θ⁻¹, hθ.inv, -e, packetExponent_neg he, -t, ?_⟩
  rw [normTwist_neg, zpow_neg]
  simp only [mul_inv_rev]
  ac_rfl

theorem packet_conjugate (logNorm : LogNorm G) (ω : UnitaryCharacter G)
    {χ : UnitaryCharacter G} (hχ : χ ∈ Packet logNorm ω) :
    conjugate χ ∈ Packet logNorm ω :=
  packet_inv logNorm ω hχ

theorem packet_mul_normTwist (logNorm : LogNorm G) (ω : UnitaryCharacter G)
    {χ : UnitaryCharacter G} (hχ : χ ∈ Packet logNorm ω) (u : ℝ) :
    χ * normTwist logNorm u ∈ Packet logNorm ω := by
  rcases hχ with ⟨θ, hθ, e, he, t, rfl⟩
  refine ⟨θ, hθ, e, he, t + u, ?_⟩
  rw [normTwist_add]
  ac_rfl

/-- Every unitary character occurs as the base character of its own packet. -/
theorem every_character_mem_some_packet (logNorm : LogNorm G) (χ : UnitaryCharacter G) :
    ∃ ω : UnitaryCharacter G, χ ∈ Packet logNorm ω :=
  ⟨χ, base_mem_packet logNorm χ⟩

section Pullback

variable {H : Type*} [CommGroup H] [TopologicalSpace H]

/-- Pull back a unitary character along an actual continuous group homomorphism. -/
def pullback (f : H →ₜ* G) (χ : UnitaryCharacter G) : UnitaryCharacter H := χ.comp f

@[simp] theorem pullback_apply (f : H →ₜ* G) (χ : UnitaryCharacter G) (x : H) :
    pullback f χ x = χ (f x) := rfl

@[simp] theorem pullback_id (χ : UnitaryCharacter G) :
    pullback (ContinuousMonoidHom.id G) χ = χ := by
  apply ContinuousMonoidHom.ext
  intro x
  rfl

theorem pullback_comp {K : Type*} [CommGroup K] [TopologicalSpace K]
     (f : H →ₜ* G) (g : K →ₜ* H) (χ : UnitaryCharacter G) :
    pullback (f.comp g) χ = pullback g (pullback f χ) := by
  apply ContinuousMonoidHom.ext
  intro x
  rfl

/-- Pullback is a homomorphism of character groups. -/
def pullbackHom (f : H →ₜ* G) : UnitaryCharacter G →* UnitaryCharacter H where
  toFun := pullback f
  map_one' := by apply ContinuousMonoidHom.ext; intro x; rfl
  map_mul' χ ψ := by apply ContinuousMonoidHom.ext; intro x; rfl

@[simp] theorem pullback_one (f : H →ₜ* G) : pullback f 1 = 1 :=
  (pullbackHom f).map_one

@[simp] theorem pullback_mul (f : H →ₜ* G) (χ ψ : UnitaryCharacter G) :
    pullback f (χ * ψ) = pullback f χ * pullback f ψ :=
  (pullbackHom f).map_mul χ ψ

@[simp] theorem pullback_zpow (f : H →ₜ* G) (χ : UnitaryCharacter G) (e : ℤ) :
    pullback f (χ ^ e) = pullback f χ ^ e :=
  (pullbackHom f).map_zpow χ e

@[simp] theorem pullback_inv (f : H →ₜ* G) (χ : UnitaryCharacter G) :
    pullback f χ⁻¹ = (pullback f χ)⁻¹ :=
  (pullbackHom f).map_inv χ

theorem finiteOrder_pullback (f : H →ₜ* G) {χ : UnitaryCharacter G}
    (hχ : FiniteOrder χ) : FiniteOrder (pullback f χ) :=
  (pullbackHom f).isOfFinOrder hχ

theorem finiteOrder_pullback_iff_of_surjective (f : H →ₜ* G)
    (hf : Function.Surjective f) (χ : UnitaryCharacter G) :
    FiniteOrder (pullback f χ) ↔ FiniteOrder χ := by
  constructor
  · intro hχ
    rcases (finiteOrder_iff_pointwise (pullback f χ)).mp hχ with ⟨n, hn, hpow⟩
    apply (finiteOrder_iff_pointwise χ).mpr
    refine ⟨n, hn, fun x => ?_⟩
    obtain ⟨y, rfl⟩ := hf x
    exact hpow y
  · exact finiteOrder_pullback f

@[simp] theorem pullback_normTwist (f : H →ₜ* G) (logNorm : LogNorm G) (t : ℝ) :
    pullback f (normTwist logNorm t) = normTwist (logNorm.comp f) t := by
  apply ContinuousMonoidHom.ext
  intro x
  rfl

theorem packet_pullback (f : H →ₜ* G) (logNorm : LogNorm G)
    (ω : UnitaryCharacter G) {χ : UnitaryCharacter G} (hχ : χ ∈ Packet logNorm ω) :
    pullback f χ ∈ Packet (logNorm.comp f) (pullback f ω) := by
  rcases hχ with ⟨θ, hθ, e, he, t, rfl⟩
  refine ⟨pullback f θ, finiteOrder_pullback f hθ, e, he, t, ?_⟩
  simp only [pullback_mul, pullback_zpow, pullback_normTwist]

/-- If two logarithmic norms are compatible, character packets pull back between them. -/
theorem packet_pullback_of_norm_compatible (f : H →ₜ* G)
    (logNormG : LogNorm G) (logNormH : LogNorm H)
    (hnorm : logNormH = logNormG.comp f) (ω : UnitaryCharacter G)
    {χ : UnitaryCharacter G} (hχ : χ ∈ Packet logNormG ω) :
    pullback f χ ∈ Packet logNormH (pullback f ω) := by
  rw [hnorm]
  exact packet_pullback f logNormG ω hχ

end Pullback

end HeckeGeneral.Characters
