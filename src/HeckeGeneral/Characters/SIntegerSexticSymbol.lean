import HeckeGeneral.Characters.SIntegerSexticIdealEvaluation
import HeckeGeneral.Arithmetic.SIntegerModulus
import HeckeGeneral.Arithmetic.SIntegerOrbits

/-! The denominator is an actual nonzero S-integer,
not a freely chosen integral ideal. The exceptional set contains the
prime support of 6. No reciprocity theorem is asserted. -/

noncomputable section
namespace HeckeGeneral.Characters
open NumberField IsDedekindDomain HeckeGeneral.Arithmetic
open scoped Classical

variable (K : Type*) [Field K] [NumberField K]
variable (S : Set (HeightOneSpectrum (𝓞 K))) [Finite S]
variable (ζ : K) (hζ : IsPrimitiveRoot ζ 6) (σ : K →+* ℂ)
variable (hS6 : integerPrimeSupport (6 : 𝓞 K) ⊆ S)

private theorem sexticModulus_exterior
    (c : NonzeroRingElements (S.integer K))
    (p : HeightOneSpectrum (𝓞 K))
    (hp : p.asIdeal ∣ sIntegerModulusContraction K S c.val) : p ∉ S := by
  intro hpin
  have hc := sIntegerModulusContraction_coprime K S c.val c.property p hpin
  have hle : sIntegerModulusContraction K S c.val ≤ p.asIdeal :=
    Ideal.dvd_iff_le.mp hp
  have htop : (⊤ : Ideal (𝓞 K)) ≤ p.asIdeal := by
    rw [← hc]
    exact sup_le hle le_rfl
  exact p.isPrime.ne_top (top_le_iff.mp htop)

include hS6 in
private theorem sexticModulus_away_six
    (c : NonzeroRingElements (S.integer K))
    (p : HeightOneSpectrum (𝓞 K))
    (hp : p.asIdeal ∣ sIntegerModulusContraction K S c.val) :
    (6 : 𝓞 K) ∉ p.asIdeal := by
  intro h6
  exact sexticModulus_exterior K S c p hp (hS6 h6)

/-- The actual two-argument sextic symbol, with denominator contraction
and all its arithmetic admissibility proofs constructed from the modulus. -/
def sIntegerSexticSymbol (a : S.integer K)
    (c : NonzeroRingElements (S.integer K)) : ℂ :=
  sIntegerSexticIdealEvaluation K S ζ hζ σ
    (sIntegerModulusContraction K S c.val)
    (sIntegerModulusContraction_ne_bot K S c.val c.property)
    (sexticModulus_exterior K S c) (sexticModulus_away_six K S hS6 c) a

/-- Literal numerator invariance on the original subgroup. -/
theorem sIntegerSexticSymbol_numerator_invariant
    (Γ : Subgroup (S.unit K))
    (hΓ : Γ ≤ (powMonoidHom 6 : S.unit K →* S.unit K).range)
    (γ : Γ) (a : S.integer K) (c : NonzeroRingElements (S.integer K)) :
    sIntegerSexticSymbol K S ζ hζ σ hS6
      ((S.unitEquivUnitsInteger K γ.val).val * a) c =
      sIntegerSexticSymbol K S ζ hζ σ hS6 a c :=
  sIntegerSexticIdealEvaluation_literal_invariant K S ζ hζ σ _ _ _ _ Γ hΓ γ a

/-- Multiplication of the literal denominator by any original S-unit
preserves its principal ideal and therefore its actual contraction. -/
theorem sIntegerSexticSymbol_denominator_invariant
    (u : S.unit K) (a : S.integer K)
    (c : NonzeroRingElements (S.integer K)) :
    sIntegerSexticSymbol K S ζ hζ σ hS6 a
      ((S.unitEquivUnitsInteger K u) • c) =
      sIntegerSexticSymbol K S ζ hζ σ hS6 a c := by
  have heq : sIntegerModulusContraction K S
      (((S.unitEquivUnitsInteger K u) • c).val) =
      sIntegerModulusContraction K S c.val := by
    unfold sIntegerModulusContraction
    congr 1
    exact Ideal.span_singleton_mul_left_unit
      (S.unitEquivUnitsInteger K u).isUnit c.val
  simp only [sIntegerSexticSymbol, heq]

/-- Actual periodicity modulo the principal ideal generated by the
literal denominator, using the proved extension-contraction identity. -/
theorem sIntegerSexticSymbol_periodic
    (a b : S.integer K) (c : NonzeroRingElements (S.integer K))
    (hab : a - b ∈ Ideal.span ({c.val} : Set (S.integer K))) :
    sIntegerSexticSymbol K S ζ hζ σ hS6 a c =
      sIntegerSexticSymbol K S ζ hζ σ hS6 b c := by
  let I := sIntegerModulusContraction K S c.val
  have hq : Ideal.Quotient.mk (I.map (algebraMap (𝓞 K) (S.integer K))) a =
      Ideal.Quotient.mk (I.map (algebraMap (𝓞 K) (S.integer K))) b := by
    apply Ideal.Quotient.eq.mpr
    simpa only [I, map_sIntegerModulusContraction] using hab
  have hf := congrArg
    (sIntegerSexticIdealQuotientFunction K S ζ hζ σ I
      (sIntegerModulusContraction_ne_bot K S c.val c.property)
      (sexticModulus_exterior K S c) (sexticModulus_away_six K S hS6 c)) hq
  simpa only [sIntegerSexticIdealQuotientFunction_mk, sIntegerSexticSymbol, I] using hf

/-- Unit denominators give the empty product, also when the numerator is zero. -/
theorem sIntegerSexticSymbol_unit_denominator
    (a : S.integer K) (c : NonzeroRingElements (S.integer K))
    (hc : IsUnit c.val) : sIntegerSexticSymbol K S ζ hζ σ hS6 a c = 1 := by
  have heq : sIntegerModulusContraction K S c.val = ⊤ := by
    change Ideal.comap (algebraMap (𝓞 K) (S.integer K))
      (Ideal.span ({c.val} : Set (S.integer K))) = ⊤
    rw [Ideal.span_singleton_eq_top.mpr hc, Ideal.comap_top]
  unfold sIntegerSexticSymbol
  simp only [heq]
  exact sIntegerSexticIdealEvaluation_top K S ζ hζ σ _ _ a

/-- A bad exterior prime still forces literal zero in the two-argument symbol. -/
theorem sIntegerSexticSymbol_eq_zero_of_badPrime
    (a : S.integer K) (c : NonzeroRingElements (S.integer K))
    (p : HeightOneSpectrum (𝓞 K))
    (hp : p.asIdeal ∣ sIntegerModulusContraction K S c.val)
    (ha : sIntegerSexticResidueMap K S p (sexticModulus_exterior K S c p hp) a = 0) :
    sIntegerSexticSymbol K S ζ hζ σ hS6 a c = 0 :=
  sIntegerSexticIdealEvaluation_eq_zero_of_badPrime K S ζ hζ σ _ _ _ _ a p hp ha

end HeckeGeneral.Characters
