import ActualAdditiveGramAmplitude
import ActualProbePairPeriodicFourier

/-!
UNCOMPILED / native 0. The literal A_m square is a finite double sum of
row-independent ideal-pair coefficients times the actual periodic negative
Gauss pair. The modulus for each pair is generated by the SAME P.arithmetic
generators as in the original amplitude. The exact Y^(-3) factor is retained.

This consumes the proved amplitude square expansion and the proved residue
representative identity. It assumes neither a correlation identity nor a
Gram estimate, and makes no assertion about the finite-ray shape of c.
No denominator, zero row, nonunit frequency or character zero is discarded.
-/

set_option autoImplicit false
set_option relaxedAutoImplicit false

noncomputable section

namespace HeckeGeneral.ThetaSkeleton.Physical.ActualAdditiveGramDraft

open NumberField IsDedekindDomain
open HeckeGeneral.Arithmetic HeckeGeneral.Characters HeckeGeneral.Analysis
open HeckeGeneral.ThetaSkeleton.Global
open ActualProbePairFourierDraft
open scoped Classical BigOperators ComplexConjugate

variable (K : Type) [Field K] [NumberField K]
variable (S : Set (HeightOneSpectrum (𝓞 K))) [Fintype S]

/-- The complete original ideal-pair coefficient, independent of the row.
The second test and the second Mellin factor are fully conjugated. -/
def actualAdditiveGramPairCoefficient (c : ExteriorIdeal K S → ℂ)
    (W : SmoothAnnularTest) (Y ν : ℝ) (I J : ExteriorIdeal K S) : ℂ :=
  (c I * conj (c J)) *
    (W.toFun (exteriorNorm K S I / Y) *
      conj (W.toFun (exteriorNorm K S J / Y))) *
    ((((exteriorNorm K S I / Y : ℝ) : ℂ) ^
        ((-1 : ℂ) + Complex.I * (ν : ℂ))) *
      conj ((((exteriorNorm K S J / Y : ℝ) : ℂ) ^
        ((-1 : ℂ) + Complex.I * (ν : ℂ)))))

/-- Literal representative identification on the actual pair modulus. -/
theorem actualAdditiveGramPairTerm_eq_coefficient_mul_residue (P : ProbeData K S)
    (c : ExteriorIdeal K S → ℂ) (W : SmoothAnnularTest)
    (Y ν : ℝ) (m : S.integer K) (I J : ExteriorIdeal K S) :
    actualAdditiveGramPairTerm K S P c W Y ν m I J =
      actualAdditiveGramPairCoefficient K S c W Y ν I J *
        probeNegativeGaussPairResidue K S P I J (Ideal.Quotient.mk _ m) := by
  simp only [actualAdditiveGramPairTerm, actualAdditiveGramPairCoefficient,
    probeNegativeGaussPairResidue_mk]

/-- The original square, with its actual finite periodic row coefficients.
The common ideal envelope is the same one for all rows and nu. -/
theorem actualAdditiveGramAmplitude_norm_sq_eq_residue_double_sum (P : ProbeData K S)
    (c : ExteriorIdeal K S → ℂ) (W : SmoothAnnularTest)
    (Y ν : ℝ) (hY : 0 < Y) (m : S.integer K) :
    ((‖actualAdditiveGramAmplitude K S P c W Y ν m‖ ^ 2 : ℝ) : ℂ) =
      ((Y ^ (-3 : ℝ) : ℝ) : ℂ) *
        ∑ I ∈ additiveGramIdealSupport K S W Y,
          ∑ J ∈ additiveGramIdealSupport K S W Y,
            actualAdditiveGramPairCoefficient K S c W Y ν I J *
              probeNegativeGaussPairResidue K S P I J (Ideal.Quotient.mk _ m) := by
  calc
    _ = ((Y ^ (-3 : ℝ) : ℝ) : ℂ) *
        ∑ I ∈ additiveGramIdealSupport K S W Y,
          ∑ J ∈ additiveGramIdealSupport K S W Y,
            actualAdditiveGramPairTerm K S P c W Y ν m I J :=
      actualAdditiveGramAmplitude_norm_sq_eq_double_sum K S P c W Y ν hY m
    _ = _ := by
      congr 1
      apply Finset.sum_congr rfl
      intro I _hI
      apply Finset.sum_congr rfl
      intro J _hJ
      exact actualAdditiveGramPairTerm_eq_coefficient_mul_residue K S P c W Y ν m I J

theorem actualAdditiveGramAmplitude_norm_sq_eq_residue_double_sum_re
    (P : ProbeData K S) (c : ExteriorIdeal K S → ℂ) (W : SmoothAnnularTest)
    (Y ν : ℝ) (hY : 0 < Y) (m : S.integer K) :
    ‖actualAdditiveGramAmplitude K S P c W Y ν m‖ ^ 2 =
      Y ^ (-3 : ℝ) *
        (∑ I ∈ additiveGramIdealSupport K S W Y,
          ∑ J ∈ additiveGramIdealSupport K S W Y,
            actualAdditiveGramPairCoefficient K S c W Y ν I J *
              probeNegativeGaussPairResidue K S P I J (Ideal.Quotient.mk _ m)).re := by
  have h := congrArg Complex.re
    (actualAdditiveGramAmplitude_norm_sq_eq_residue_double_sum K S P c W Y ν hY m)
  simpa only [Complex.ofReal_re, Complex.re_ofReal_mul] using h

end HeckeGeneral.ThetaSkeleton.Physical.ActualAdditiveGramDraft
