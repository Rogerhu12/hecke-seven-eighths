import HeckeSkeleton.Moments.MOM_ENGINE_STEP.CanonicalOriginalChildData
import HeckePort.Moments.NaturalPrimitive

/-!
# Full moving support from the original individual factors

Each displayed moving factor is the original nonzero S-integer, even
when its character exponent is zero or cancels another exponent. Its
computed exterior ideal is proved to be generated by that same element.
Individual generated-ideal formulas therefore identify the entire
displayed prime support without any character reclassification.

The primitive support input below consists of one generated ideal for
each original factor, its divisibility by powers of the three original
support ideals, and the remaining ideal's genuine divisibility. Their
union, its norm window and the complete Boolean mask identity are
conclusions. The resulting exterior support is fixed independently of
the row and both Fourier parameters. No full-support divisibility,
joint row budget, admissibility or energy bound is a raw field.
-/

noncomputable section
open scoped Classical BigOperators NumberField nonZeroDivisors

namespace HeckeSkeleton.Moments.EngineStep

open NumberField IsDedekindDomain DedekindZetaZeroFree UniqueFactorizationMonoid
open HeckeGeneral.Arithmetic HeckeGeneral.Characters HeckeGeneral.Analysis
open HeckeGeneral.Analysis.ConditionalMoments HeckeGeneral.Analysis.ActualSIntegerMoments
open HeckeGeneral.ThetaSkeleton HeckeGeneral.ThetaSkeleton.Global
open HeckeGeneral.ThetaSkeleton.Physical
open HeckePort.Moments HeckePort.IdealMobiusDivisorSum CommonSupportMass

variable {K : Type} [Field K] [NumberField K]
variable {A : SArithmeticData K}
variable {P : ProbeData K (A.Sf : Set (HeightOneSpectrum (𝓞 K)))}
variable {R : RowCharacterInput K (A.Sf : Set (HeightOneSpectrum (𝓞 K))) P}

namespace OriginalMovingFactors

variable (D : OriginalMovingFactors A P R)

/-- The ideal read from the original probe's orbit equivalence is the
contraction of the original factor's principal ideal. -/
theorem factorIdeal_val_eq_contraction (i : Fin D.count) :
    (D.factorIdeal i).val = sIntegerModulusContraction K
      (A.Sf : Set (HeightOneSpectrum (𝓞 K))) (D.element i).val := by
  have he := congrArg (fun I : HeckeGeneral.Analysis.NonzeroIdeal K => I.val)
    (decomposedIdealSectorOrbit_ideal K
      (A.Sf : Set (HeightOneSpectrum (𝓞 K))) P (D.decomposition i))
  rw [D.decomposition_orbit i] at he
  exact he.symm

/-- This is an identity for the actual element, including its unit
sector. No substitute generator of its exterior ideal is selected. -/
theorem factorIdeal_generates (i : Fin D.count) :
    A.Generates (D.factorIdeal i) (D.element i).val := by
  refine ⟨(D.element i).property, ?_⟩
  change Ideal.span {(D.element i).val} =
    Ideal.map (algebraMap (𝓞 K) A.R) (D.factorIdeal i).val
  rw [D.factorIdeal_val_eq_contraction i,
    map_sIntegerModulusContraction K (A.Sf : Set (HeightOneSpectrum (𝓞 K)))]

theorem factorIdeal_eq_of_generates (i : Fin D.count) (I : A.Exterior)
    (hI : A.Generates I (D.element i).val) : D.factorIdeal i = I := by
  apply A.exteriorIdealEquiv.injective
  apply Subtype.ext
  change A.extendIdeal (D.factorIdeal i) = A.extendIdeal I
  exact (D.factorIdeal_generates i).2.symm.trans hI.2

/-- Every prime of the displayed support belongs to an actual listed
factor, and every prime of every listed factor is retained. -/
theorem mem_support_iff (p : Ideal (𝓞 K)) :
    p ∈ primeSupport D.support.val ↔
      ∃ i : Fin D.count, p ∈ primeSupport (D.factorIdeal i).val := by
  rw [D.support_primes]
  constructor
  · intro hp
    have hprime := support_prime hp
    have hd := (prime_mem_support_iff_dvd p D.fullIdeal.val hprime
      D.fullIdeal.property.1).mp hp
    change p ∣ ∏ i, (D.factorIdeal i).val at hd
    obtain ⟨i, _, hi⟩ := (hprime.dvd_finsetProd_iff (fun i => (D.factorIdeal i).val)).mp hd
    exact ⟨i, (prime_mem_support_iff_dvd p (D.factorIdeal i).val hprime
      (D.factorIdeal i).property.1).mpr hi⟩
  · rintro ⟨i, hi⟩
    have hprime := support_prime hi
    have hd := (prime_mem_support_iff_dvd p (D.factorIdeal i).val hprime
      (D.factorIdeal i).property.1).mp hi
    apply (prime_mem_support_iff_dvd p D.fullIdeal.val hprime
      D.fullIdeal.property.1).mpr
    exact hd.trans (Finset.dvd_prod_of_mem (fun i => (D.factorIdeal i).val)
      (Finset.mem_univ i))

theorem fullMaskSupport_primes (remaining : HeckeGeneral.Analysis.NonzeroIdeal K) :
    primeSupport (D.fullMaskSupport remaining).val =
      primeSupport D.support.val ∪ primeSupport remaining.val := by
  change primeSupport (commonRadical (D.support.val * remaining.val)
    (D.support.val * remaining.val)) = _
  rw [commonRadical_support, Finset.inter_self]
  simp only [primeSupport,
    normalizedFactors_mul D.support.property.1 (nonZeroDivisors.ne_zero remaining.property),
    Multiset.toFinset_add]

/-- Coprimality to the one full support is exactly both original
deletions. This holds for every ideal, including the zero ideal. -/
theorem fullMaskSupport_coprime_iff
    (remaining : HeckeGeneral.Analysis.NonzeroIdeal K) (I : Ideal (𝓞 K)) :
    IsCoprime I (D.fullMaskSupport remaining).val ↔
      IsCoprime I D.support.val ∧ IsCoprime I remaining.val := by
  have hprod : D.support.val * remaining.val ≠ 0 :=
    mul_ne_zero D.support.property.1 (nonZeroDivisors.ne_zero remaining.property)
  calc
    _ ↔ IsCoprime I (D.support.val * remaining.val) := by
      change IsCoprime I
        (commonRadical (D.support.val * remaining.val) (D.support.val * remaining.val)) ↔ _
      rw [coprime_support_iff I _
        (commonRadical_ne_zero _ _),
        coprime_support_iff I _ hprod, commonRadical_support, Finset.inter_self]
    _ ↔ _ := IsCoprime.mul_right_iff

/-- The same complete row mask, followed by the two original
deletions, is exactly the complete row mask followed by full support. -/
theorem fullMaskSupport_mask (remaining : HeckeGeneral.Analysis.NonzeroIdeal K)
    (rowMask : Bool) (I : Ideal (𝓞 K)) :
    ((rowMask && decide (IsCoprime I D.support.val)) &&
      decide (IsCoprime I remaining.val)) =
      (rowMask && decide (IsCoprime I (D.fullMaskSupport remaining).val)) := by
  simp only [D.fullMaskSupport_coprime_iff remaining I, Bool.decide_and, Bool.and_assoc]

/-- The displayed support is obtained by a finite union of the
individual factor radicals; repeated factors add no new prime. -/
theorem support_dvd_of_factor_radicals
    (J : Ideal (𝓞 K)) (hJ : J ≠ 0)
    (hatoms : ∀ i : Fin D.count,
      commonRadical (D.factorIdeal i).val (D.factorIdeal i).val ∣ J) :
    D.support.val ∣ J := by
  rw [← squarefree_support_product_self D.support_squarefree]
  apply support_product_dvd hJ
  intro p hp
  obtain ⟨i, hi⟩ := (D.mem_support_iff p).mp hp
  have hprime := support_prime hi
  have hirad : p ∈ primeSupport
      (commonRadical (D.factorIdeal i).val (D.factorIdeal i).val) := by
    rw [commonRadical_support, Finset.inter_self]
    exact hi
  have hd := (prime_mem_support_iff_dvd p _ hprime (commonRadical_ne_zero _ _)).mp hirad
  exact (prime_mem_support_iff_dvd p J hprime hJ).mpr (hd.trans (hatoms i))

/-- The fixed remaining ideal is included before taking the radical.
This derives full-support divisibility from individual factor support
identities and its own original divisor identity. -/
theorem fullMaskSupport_dvd_of_factor_radicals
    (remaining : HeckeGeneral.Analysis.NonzeroIdeal K)
    (J : Ideal (𝓞 K)) (hJ : J ≠ 0)
    (hatoms : ∀ i : Fin D.count,
      commonRadical (D.factorIdeal i).val (D.factorIdeal i).val ∣ J)
    (hremaining : remaining.val ∣ J) :
    (D.fullMaskSupport remaining).val ∣ J := by
  have hs := D.support_dvd_of_factor_radicals J hJ hatoms
  rw [← squarefree_support_product_self (D.fullMaskSupport_squarefree remaining)]
  apply support_product_dvd hJ
  intro p hp
  have hprime := support_prime hp
  rw [D.fullMaskSupport_primes remaining] at hp
  rcases Finset.mem_union.mp hp with hp | hp
  · have hd := (prime_mem_support_iff_dvd p D.support.val hprime D.support.property.1).mp hp
    exact (prime_mem_support_iff_dvd p J hprime hJ).mpr (hd.trans hs)
  · have hd := (prime_mem_support_iff_dvd p remaining.val hprime
      (nonZeroDivisors.ne_zero remaining.property)).mp hp
    exact (prime_mem_support_iff_dvd p J hprime hJ).mpr (hd.trans hremaining)

/-- Primitive generated-ideal formulas for each actual displayed
factor, with arbitrary multiplicities. They are independent of the
integer exponents of the moving characters, including exponent zero.
The complete support and its norm bound are deliberately not fields. -/
structure SupportAtoms (D : OriginalMovingFactors A P R)
    (old unit nonunit : A.Exterior) (remaining : HeckeGeneral.Analysis.NonzeroIdeal K) where
  ideal : Fin D.count → A.Exterior
  generates : ∀ i, A.Generates (ideal i) (D.element i).val
  oldPower : Fin D.count → ℕ
  unitPower : Fin D.count → ℕ
  nonunitPower : Fin D.count → ℕ
  factor_divides : ∀ i, (ideal i).val ∣
    old.val ^ oldPower i * unit.val ^ unitPower i * nonunit.val ^ nonunitPower i
  remaining_divides : remaining.val ∣ old.val * unit.val * nonunit.val

namespace SupportAtoms

variable {D} {old unit nonunit : A.Exterior}
variable {remaining : HeckeGeneral.Analysis.NonzeroIdeal K}
variable (W : D.SupportAtoms old unit nonunit remaining)

include W

theorem factorIdeal_eq (i : Fin D.count) : D.factorIdeal i = W.ideal i :=
  D.factorIdeal_eq_of_generates i (W.ideal i) (W.generates i)

/-- An actual prime of one generated factor must occur in one of the
three original supports, however large that factor's multiplicity. -/
theorem factorRadical_dvd (i : Fin D.count) :
    commonRadical (D.factorIdeal i).val (D.factorIdeal i).val ∣
      old.val * unit.val * nonunit.val := by
  have htarget : old.val * unit.val * nonunit.val ≠ 0 :=
    mul_ne_zero (mul_ne_zero old.property.1 unit.property.1) nonunit.property.1
  unfold commonRadical
  rw [Finset.inter_self]
  apply support_product_dvd htarget
  intro p hp
  have hprime := support_prime hp
  have hd := (prime_mem_support_iff_dvd p (D.factorIdeal i).val hprime
    (D.factorIdeal i).property.1).mp hp
  rw [W.factorIdeal_eq i] at hd
  have hpowers := hd.trans (W.factor_divides i)
  have htargetdvd : p ∣ old.val * unit.val * nonunit.val := by
    rcases hprime.dvd_or_dvd hpowers with hleft | hnonunit
    · rcases hprime.dvd_or_dvd hleft with hold | hunit
      · exact dvd_mul_of_dvd_left (dvd_mul_of_dvd_left (hprime.dvd_of_dvd_pow hold) _) _
      · exact dvd_mul_of_dvd_left (dvd_mul_of_dvd_right (hprime.dvd_of_dvd_pow hunit) _) _
    · exact dvd_mul_of_dvd_right (hprime.dvd_of_dvd_pow hnonunit) _
  exact (prime_mem_support_iff_dvd p _ hprime htarget).mpr htargetdvd

theorem fullMaskSupport_dvd :
    (D.fullMaskSupport remaining).val ∣ old.val * unit.val * nonunit.val :=
  D.fullMaskSupport_dvd_of_factor_radicals remaining _
    (mul_ne_zero (mul_ne_zero old.property.1 unit.property.1) nonunit.property.1)
    W.factorRadical_dvd W.remaining_divides

/-- The same full support as an exterior ideal, fixed before every
source row and Fourier parameter. Exteriority follows from its proved
divisibility, not from a new support assumption. -/
def fullSupport : A.Exterior := by
  refine ⟨(D.fullMaskSupport remaining).val,
    nonZeroDivisors.ne_zero (D.fullMaskSupport remaining).property, ?_⟩
  have hcop : IsCoprime (old.val * unit.val * nonunit.val) A.cS :=
    ((Ideal.isCoprime_iff_sup_eq.mpr old.property.2).mul_left
      (Ideal.isCoprime_iff_sup_eq.mpr unit.property.2)).mul_left
        (Ideal.isCoprime_iff_sup_eq.mpr nonunit.property.2)
  exact (hcop.of_isCoprime_of_dvd_left W.fullMaskSupport_dvd).sup_eq

@[simp] theorem fullSupport_val : W.fullSupport.val = (D.fullMaskSupport remaining).val := rfl

/-- Classifying the fixed original factors with another row's three
support ideals changes only the certificate, never the full support. -/
theorem fullSupport_eq {old' unit' nonunit' : A.Exterior}
    (W' : D.SupportAtoms old' unit' nonunit' remaining) :
    W.fullSupport = W'.fullSupport := Subtype.ext rfl

theorem fullSupport_squarefree : Squarefree W.fullSupport.val :=
  D.fullMaskSupport_squarefree remaining

@[simp] theorem fullSupport_norm :
    A.exteriorNorm W.fullSupport = idealNorm K (D.fullMaskSupport remaining) := rfl

/-- Only the three original support norms are charged. The number of
moving factors and their repeated multiplicities add no scalar loss. -/
theorem fullMaskSupport_norm_le :
    idealNorm K (D.fullMaskSupport remaining) ≤
      A.exteriorNorm old * A.exteriorNorm unit * A.exteriorNorm nonunit := by
  calc
    _ ≤ (Ideal.absNorm (old.val * unit.val * nonunit.val) : ℝ) :=
      norm_le_of_dvd
        (mul_ne_zero (mul_ne_zero old.property.1 unit.property.1) nonunit.property.1)
        W.fullMaskSupport_dvd
    _ = _ := by simp only [map_mul, Nat.cast_mul] <;> rfl

theorem fullMaskSupport_norm_window
    (Z oldLength unitLength nonunitLength : ℝ) (hZ : 0 < Z)
    (hold : A.exteriorNorm old ≤ Z ^ oldLength)
    (hunit : A.exteriorNorm unit ≤ Z ^ unitLength)
    (hnonunit : A.exteriorNorm nonunit ≤ Z ^ nonunitLength) :
    idealNorm K (D.fullMaskSupport remaining) ≤
      Z ^ (oldLength + unitLength + nonunitLength) := by
  have hprod := mul_le_mul
    (mul_le_mul hold hunit (Nat.cast_nonneg _) (Real.rpow_nonneg hZ.le _))
    hnonunit (Nat.cast_nonneg _)
    (mul_nonneg (Real.rpow_nonneg hZ.le _) (Real.rpow_nonneg hZ.le _))
  exact W.fullMaskSupport_norm_le.trans
    (hprod.trans_eq (by rw [← Real.rpow_add hZ, ← Real.rpow_add hZ]))

theorem support_norm_window
    (Z oldLength unitLength nonunitLength : ℝ) (hZ : 0 < Z)
    (hold : A.exteriorNorm old ≤ Z ^ oldLength)
    (hunit : A.exteriorNorm unit ≤ Z ^ unitLength)
    (hnonunit : A.exteriorNorm nonunit ≤ Z ^ nonunitLength) :
    A.exteriorNorm D.support ≤ Z ^ (oldLength + unitLength + nonunitLength) :=
  (D.support_norm_le_fullMaskSupport remaining).trans
    (W.fullMaskSupport_norm_window Z oldLength unitLength nonunitLength hZ hold hunit hnonunit)

/-- The literal row norm factorization combines an individual physical
source-row window with the proved full-support window. No completed
joint row bound is an input. -/
theorem actualRow_joint_window
    {Ih : A.Exterior} {h g : A.R} {factor : ℝ}
    (row : ActualChildRow Ih h g factor)
    (Z rowLength oldLength unitLength nonunitLength : ℝ) (hZ : 0 < Z)
    (hrow : A.exteriorNorm Ih ≤ factor * Z ^ rowLength)
    (hold : A.exteriorNorm old ≤ Z ^ oldLength)
    (hunit : A.exteriorNorm unit ≤ Z ^ unitLength)
    (hnonunit : A.exteriorNorm nonunit ≤ Z ^ nonunitLength) :
    idealNorm K row.momentIdeal * idealNorm K (D.fullMaskSupport remaining) ≤
      Z ^ (rowLength + (oldLength + unitLength + nonunitLength)) := by
  have hnorm := row.norm_le (Z ^ rowLength) hrow
  have hs := W.fullMaskSupport_norm_window
    Z oldLength unitLength nonunitLength hZ hold hunit hnonunit
  have hmul := mul_le_mul hnorm hs (idealNorm_pos K _).le (Real.rpow_nonneg hZ.le _)
  exact hmul.trans_eq (Real.rpow_add hZ _ _).symm

end SupportAtoms
end OriginalMovingFactors

namespace CompleteMovingRowRecipe

variable {ω ψ : HeckeCharacter K} {X : Type*} {data : X → MomentData K ω ψ}
variable (Q : CompleteMovingRowRecipe A P R data)
variable {old unit nonunit : A.Exterior}
variable (W : Q.moving.SupportAtoms old unit nonunit Q.remaining)

include W

/-- The complete engine mask is obtained from the fixed full support,
including the remaining ideal. It is literally independent of the row. -/
def fullMovingMaskRecipe : ActualMovingMaskRecipe A data where
  support _ := W.fullSupport
  squarefree _ := W.fullSupport_squarefree
  mask ξ u I := (Q.mask ξ u I).trans
    (Q.moving.fullMaskSupport_mask Q.remaining
      (completeIdealCommonMask K (A.Sf : Set (HeightOneSpectrum (𝓞 K))) u I) I)

@[simp] theorem fullMovingMaskRecipe_support (u : HeckeGeneral.Analysis.NonzeroIdeal K) :
    (Q.fullMovingMaskRecipe W).support u = W.fullSupport := rfl

theorem supportBudget_of_original_windows
    (Z oldLength unitLength nonunitLength : ℝ) (hZ : 0 < Z)
    (hold : A.exteriorNorm old ≤ Z ^ oldLength)
    (hunit : A.exteriorNorm unit ≤ Z ^ unitLength)
    (hnonunit : A.exteriorNorm nonunit ≤ Z ^ nonunitLength) :
    Q.SupportBudget Z (oldLength + unitLength + nonunitLength) :=
  W.support_norm_window Z oldLength unitLength nonunitLength hZ hold hunit hnonunit

end CompleteMovingRowRecipe

namespace CanonicalOriginalChildData

variable {ω ψ : HeckeCharacter K}
variable (parent : MomentData K ω ψ) (moving : OriginalMovingFactors A P R)
variable (correction : HeckeCharacter K) (hcorr : correction = 1 ∨ correction ∈ parent.theta)
variable (sector : HeckeGeneral.Analysis.NonzeroIdeal K →
  SixthUnitClasses K (A.Sf : Set (HeightOneSpectrum (𝓞 K))))
variable (remaining : HeckeGeneral.Analysis.NonzeroIdeal K)
variable {old unit nonunit : A.Exterior}
variable (W : moving.SupportAtoms old unit nonunit remaining)

include W

/-- The canonical child's actual allowed-row predicate follows from
the individual original support formulas and one physical source row.
The source and its original element are retained exactly. -/
theorem source_allowed_of_original_windows
    {Ih : A.Exterior} {h g : A.R} {factor : ℝ}
    (row : ActualChildRow Ih h g factor)
    (inverse left right : IdealTest K) (geometry : SlotGeometry K)
    (index : Fin geometry.slotCount → Fin parent.geometry.slotCount)
    (Z rowLength oldLength unitLength nonunitLength width : ℝ) (hZ : 1 ≤ Z)
    (hrow : A.exteriorNorm Ih ≤ factor * Z ^ rowLength)
    (hold : A.exteriorNorm old ≤ Z ^ oldLength)
    (hunit : A.exteriorNorm unit ≤ Z ^ unitLength)
    (hnonunit : A.exteriorNorm nonunit ≤ Z ^ nonunitLength)
    (hwidth : rowLength + (oldLength + unitLength + nonunitLength) ≤ width) :
    (data parent moving correction hcorr sector remaining (Z ^ width)
      inverse left right geometry index).allowedRow row.momentIdeal := by
  refine ⟨(HeckeAxiom.exteriorEquiv A row.ideal).property, ?_⟩
  exact (W.actualRow_joint_window row Z rowLength oldLength unitLength nonunitLength
    (zero_lt_one.trans_le hZ) hrow hold hunit hnonunit).trans
      (Real.rpow_le_rpow_of_exponent_le hZ hwidth)

end CanonicalOriginalChildData
end HeckeSkeleton.Moments.EngineStep

