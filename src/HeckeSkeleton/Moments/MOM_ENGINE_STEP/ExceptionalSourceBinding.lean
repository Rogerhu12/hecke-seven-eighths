import HeckeSkeleton.Moments.MOM_ENGINE_STEP.ActualExceptionalContribution
import HeckeSkeleton.Moments.MOM_ENGINE_STEP.SecondCenteredBinding

/-!
# Exceptional estimates on the actual allocated second source

The row selected by the actual second source is kept literally.  Its
missing ideal factorization follows by uniqueness of the extracted
element and of the exterior ideal generated by that element.  The
pointwise exceptional charts below construct the amplitude record from
the actual source fields, without assuming any whole polynomial identity.
-/

noncomputable section
open scoped Classical BigOperators NumberField nonZeroDivisors

namespace HeckeSkeleton.Moments.EngineStep

open NumberField IsDedekindDomain DedekindZetaZeroFree LocalFiniteSums
open HeckeGeneral.Characters HeckeGeneral.Analysis

set_option maxHeartbeats 2000000

variable {F : Type} [Field F] [NumberField F]
variable {A : SArithmeticData F} {σ : F →+* ℂ}
variable {η : RayClassCharacter F A.modulus} {hS : A.ContainsTraceBadPlaces}

namespace ActualChildRow

variable {Ih : A.Exterior} {h g : A.R} {Q : ℝ}

theorem element_eq_of_common_factor (r s : ActualChildRow Ih h g Q) (hg : g ≠ 0) :
    r.element = s.element :=
  mul_left_cancel₀ hg (r.frequency.symm.trans s.frequency)

theorem ideal_eq_of_common_factor (r s : ActualChildRow Ih h g Q) (hg : g ≠ 0) :
    r.ideal = s.ideal := by
  apply A.exteriorIdealEquiv.injective
  apply Subtype.ext
  change A.extendIdeal r.ideal = A.extendIdeal s.ideal
  rw [← r.generates.2, ← s.generates.2, r.element_eq_of_common_factor s hg]

end ActualChildRow

namespace ActualSecondCorrelationRows

variable {H ι : Type*} [Fintype ι] [DecidableEq ι]
variable (R : ActualSecondCorrelationRows A σ H ι)

/-- This proves the ideal factorization for the already selected row.
It does not replace that row with an independently selected generator. -/
theorem extractedRow_ideal_factor (C : A.GeneralArithmeticContext σ η hS) (x : R.live) :
    (R.originalIdeal x.val).val =
      gcd (primePowerProduct R.primes R.leftMultiplicity).val
          (primePowerProduct R.primes R.rightMultiplicity).val *
        (nonunitFrequencyRadical C R.primes R.leftMultiplicity R.rightMultiplicity
          (R.frequency x.val)).val * (R.extractedRow C x).ideal.val := by
  obtain ⟨e⟩ := exists_actual_exceptional_row C R.primes R.primes_injective
    R.leftMultiplicity R.rightMultiplicity R.leftGenerator R.rightGenerator
    R.leftGenerates R.rightGenerates (R.originalIdeal x.val) (R.frequency x.val)
    (R.generates x.val (Finset.mem_filter.mp x.property).1)
    (Finset.mem_filter.mp x.property).2
  have hg : R.factor C x.val ≠ 0 := by
    intro hz
    have he := (R.extractedRow C x).frequency
    have hzero : R.factor C x.val * (R.extractedRow C x).element = 0 :=
      (congrArg (fun a : A.R => a * (R.extractedRow C x).element) hz).trans (zero_mul _)
    exact (R.generates x.val (Finset.mem_filter.mp x.property).1).1 (he.trans hzero)
  have hi : (R.extractedRow C x).ideal = e.ideal :=
    (R.extractedRow C x).ideal_eq_of_common_factor e.toActualChildRow hg
  simpa only [hi] using e.ideal_factor

/-- Same element, same ideal, same norm identity as the actual source. -/
def exceptionalRow (C : A.GeneralArithmeticContext σ η hS) (x : R.live) :
    ActualExceptionalRow C R.primes R.leftMultiplicity R.rightMultiplicity
      (R.originalIdeal x.val) (R.frequency x.val) where
  toActualChildRow := R.extractedRow C x
  ideal_factor := R.extractedRow_ideal_factor C x

@[simp] theorem exceptionalRow_element (C : A.GeneralArithmeticContext σ η hS) (x : R.live) :
    (R.exceptionalRow C x).element = (R.extractedRow C x).element := rfl

@[simp] theorem exceptionalRow_ideal (C : A.GeneralArithmeticContext σ η hS) (x : R.live) :
    (R.exceptionalRow C x).ideal = (R.extractedRow C x).ideal := rfl

end ActualSecondCorrelationRows

namespace ActualAllocatedSource

variable {V H : Type*} [NormedAddCommGroup V] [InnerProductSpace ℝ V] {k : ℕ}
variable (s : ActualAllocatedSource A V H k)
variable (Y₁ Y₂ : ℝ) (v₁ v₂ : H → HeckeGeneral.Analysis.NonzeroIdeal F → ℂ)
variable (Ψ : Ideal (𝓞 F) →* ℂ) (W₁ W₂ : ℝ → ℂ) (ξ : V) (h : H)

/-- Only individual ideal/profile dictionaries and the original formal
scale identities.  All source coefficients, locations and masks in the
polynomial are inherited from s. -/
structure ExceptionalAt where
  mask : Ideal (𝓞 F)
  time : ℝ
  product : ℝ
  lower : ℝ
  lower_pos : 0 < lower
  X₁_lower : lower ≤ s.scale₁ / idealNorm F (s.allocation.plainDivisor 0)
  X₂_lower : lower ≤ s.scale₂ / idealNorm F (s.allocation.plainDivisor (Fin.succ 0))
  Y₁_lower : lower ≤ Y₁ / idealNorm F (s.allocation.plainDivisor 0)
  Y₂_lower : lower ≤ Y₂ / idealNorm F (s.allocation.plainDivisor (Fin.succ 0))
  productX : (s.scale₁ / idealNorm F (s.allocation.plainDivisor 0)) *
    (s.scale₂ / idealNorm F (s.allocation.plainDivisor (Fin.succ 0))) = product
  productY : (Y₁ / idealNorm F (s.allocation.plainDivisor 0)) *
    (Y₂ / idealNorm F (s.allocation.plainDivisor (Fin.succ 0))) = product
  chartX₁ : ExceptionalPlainChart (σ := σ)
    (s.characters h).plain (s.characters h).plainTwist (s.characters h).mask
    (s.extractedFactor h) (s.row h).element Ψ mask W₁ time
    (s.scale₁ / idealNorm F (s.allocation.plainDivisor 0)) s.allocation.childPlain₁
    (fun I => s.leftWeight h (s.allocation.plainDivisor 0 * I))
    (fun I => s.leftLocation h (s.allocation.plainDivisor 0 * I)) ξ
  chartX₂ : ExceptionalPlainChart (σ := σ)
    (s.characters h).plain (s.characters h).plainTwist (s.characters h).mask
    (s.extractedFactor h) (s.row h).element Ψ mask W₂ time
    (s.scale₂ / idealNorm F (s.allocation.plainDivisor (Fin.succ 0))) s.allocation.childPlain₂
    (fun I => s.rightWeight h (s.allocation.plainDivisor (Fin.succ 0) * I))
    (fun I => s.rightLocation h (s.allocation.plainDivisor (Fin.succ 0) * I)) ξ
  chartY₁ : ExceptionalPlainChart (σ := σ)
    (s.characters h).plain (s.characters h).plainTwist (s.characters h).mask
    (s.extractedFactor h) (s.row h).element Ψ mask W₁ time
    (Y₁ / idealNorm F (s.allocation.plainDivisor 0)) s.allocation.childPlain₁
    (fun I => v₁ h (s.allocation.plainDivisor 0 * I))
    (fun I => s.leftLocation h (s.allocation.plainDivisor 0 * I)) ξ
  chartY₂ : ExceptionalPlainChart (σ := σ)
    (s.characters h).plain (s.characters h).plainTwist (s.characters h).mask
    (s.extractedFactor h) (s.row h).element Ψ mask W₂ time
    (Y₂ / idealNorm F (s.allocation.plainDivisor (Fin.succ 0))) s.allocation.childPlain₂
    (fun I => v₂ h (s.allocation.plainDivisor (Fin.succ 0) * I))
    (fun I => s.rightLocation h (s.allocation.plainDivisor (Fin.succ 0) * I)) ξ

namespace ExceptionalAt

variable {s Y₁ Y₂ v₁ v₂ Ψ W₁ W₂ ξ h}

def source (T : s.ExceptionalAt (σ := σ) Y₁ Y₂ v₁ v₂ Ψ W₁ W₂ ξ h) :
    AllocatedExceptionalSource (V := V) (σ := σ) Ψ W₁ W₂
      (s.extractedFactor h) (s.row h).element k where
  allocation := s.allocation
  characters := s.characters h
  X₁ := s.scale₁
  X₂ := s.scale₂
  Y₁ := Y₁
  Y₂ := Y₂
  Zslot := s.base
  length := s.length
  w₁ := s.leftWeight h
  w₂ := s.rightWeight h
  v₁ := v₁ h
  v₂ := v₂ h
  w := s.slotWeight h
  x₁ := s.leftLocation h
  x₂ := s.rightLocation h
  x := s.slotLocation h
  ξ := ξ
  mask := T.mask
  time := T.time
  product := T.product
  lower := T.lower
  lower_pos := T.lower_pos
  X₁_lower := T.X₁_lower
  X₂_lower := T.X₂_lower
  Y₁_lower := T.Y₁_lower
  Y₂_lower := T.Y₂_lower
  productX := T.productX
  productY := T.productY
  chartX₁ := T.chartX₁
  chartX₂ := T.chartX₂
  chartY₁ := T.chartY₁
  chartY₂ := T.chartY₂

theorem value_eq (T : s.ExceptionalAt (σ := σ) Y₁ Y₂ v₁ v₂ Ψ W₁ W₂ ξ h) :
    T.source.value = jointFourierColumn s.allocation.columns
      (fun y =>
        rawSourceCoefficient (σ := σ) (s.characters h) (s.extractedFactor h) (s.row h).element
          s.scale₁ s.scale₂ s.base s.length (s.leftWeight h) (s.rightWeight h) (s.slotWeight h) y -
        rawSourceCoefficient (σ := σ) (s.characters h) (s.extractedFactor h) (s.row h).element
          Y₁ Y₂ s.base s.length (v₁ h) (v₂ h) (s.slotWeight h) y)
      (rawSourceLocation (s.leftLocation h) (s.rightLocation h) (s.slotLocation h)) ξ := rfl

end ExceptionalAt

/-- Exact weighted energy of the actual source, with the whole centered
subtraction still inside each column norm. -/
theorem centeredEnergy_eq_exceptionalValues
    (T : ∀ h, s.ExceptionalAt (σ := σ) Y₁ Y₂ v₁ v₂ Ψ W₁ W₂ ξ h) :
    s.centeredEnergy (σ := σ) Y₁ Y₂ v₁ v₂ ξ =
      ∑ h ∈ s.rows, ‖s.weight h‖ * ‖(T h).source.value‖ ^ 2 := rfl

end ActualAllocatedSource
end HeckeSkeleton.Moments.EngineStep

#print axioms HeckeSkeleton.Moments.EngineStep.ActualSecondCorrelationRows.extractedRow_ideal_factor
#print axioms HeckeSkeleton.Moments.EngineStep.ActualAllocatedSource.centeredEnergy_eq_exceptionalValues

