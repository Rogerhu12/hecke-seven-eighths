import HeckeSkeleton.ExpansionModels.SourceData
import HeckeSkeleton.Moments.MOM_UNIFORM_AMPLIFY.SixthPowerMasks

/-!
# The original sixth-power masks of the single source recipe

The unmarked family is generated by `RecipeFamily.inverseFamily`.  Its
complete-row predicate, calibrated character and common mask are the actual
arithmetic fields at every pair of scales and every parameter value.  Thus
the sixth-power identity is a theorem of the constructor, without a moment
estimate, a calibration hypothesis restricted to physical rows, or an
assumed extension of a moving character.
-/

set_option autoImplicit false
noncomputable section

namespace HeckeSkeleton.Moments.UniformAmplify

open NumberField IsDedekindDomain
open HeckeGeneral.Arithmetic HeckeGeneral.Characters HeckeGeneral.Analysis
open HeckeGeneral.Analysis.ConditionalMoments
open HeckeGeneral.ThetaSkeleton HeckeGeneral.ThetaSkeleton.Physical
open HeckeGeneral.ThetaSkeleton.Global
open scoped Classical

variable {K : Type} [Field K] [NumberField K]
variable {c : TargetContext K}

/-- The same complete ideal, base character and original fixed-place mask
are used by every member of the independent-scale source family. -/
theorem recipe_unmarked_arithmetic
    (R : ExpansionRecipe.RecipeExpansion K (places K c) (targetCharacter K c)
      c.geometry (expansionShellAllowance K c))
    (U D : ℝ) (s : SixthUnitClasses K (places K c))
    (ξ : ExpansionRecipe.RecipeVector)
    (σ τ : NonzeroIdeal K → ExpansionRecipe.RecipeVector) :
    let d := (recipeMomentModels K c R).unmarked U D s ξ σ τ
    d.allowedRow = completeIdealIsExterior K (places K c) ∧
      d.rowCharacter = completeIdealRowCharacter K (places K c)
        (probeData K c) (momentRowCharacters K c) s ∧
      d.commonMask = completeIdealCommonMask K (places K c) :=
  ⟨rfl, rfl, rfl⟩

/-- MI-I-SIXTH-POWER-ZEROS for the actual common recipe, before the named
global source is selected.  No analytic premise is required. -/
theorem recipeMomentModels_sixthPowerMasks
    (R : ExpansionRecipe.RecipeExpansion K (places K c) (targetCharacter K c)
      c.geometry (expansionShellAllowance K c)) :
    SixthPowerMaskIdentityFor (recipeMomentModels K c R) := by
  intro U D s ξ σ τ u a hu
  obtain ⟨hrows, hchar, hmask⟩ := recipe_unmarked_arithmetic R U D s ξ σ τ
  exact momentData_sixthPowerMasks_of_arithmetic_calibration
    (places K c) (probeData K c) (momentRowCharacters K c)
    ((recipeMomentModels K c R).unmarked U D s ξ σ τ) s
    hrows hchar hmask u a hu

end HeckeSkeleton.Moments.UniformAmplify

#print axioms HeckeSkeleton.Moments.UniformAmplify.recipe_unmarked_arithmetic
#print axioms HeckeSkeleton.Moments.UniformAmplify.recipeMomentModels_sixthPowerMasks
