import HeckeSkeleton.ExpansionModels.CoefficientZeroCalibration
import HeckeSkeleton.ExpansionModels.SharedWitnessRecipe
import HeckeGeneral.Analysis.IdealMobiusDeletion

/-!
# The original fixed-S/6/row-coprimality mask as an actual deleted coefficient

The finite deleted prime set is explicit.  It includes every prime dividing
the complete row, whether or not that prime ramifies in the inducing Hecke
character.  Thus no sixth-power descent or conductor simplification removes
any original zero.  The resulting weight is a genuine multiplicative map
on integral ideals and can be supplied directly to the ideal detector.

Project adapter: the full import closure has not been compiled in this task.
-/

set_option autoImplicit false
noncomputable section

namespace HeckeGeneral.Analysis.ExpansionRecipe

open NumberField IsDedekindDomain UniqueFactorizationMonoid
open HeckeGeneral.Arithmetic HeckeGeneral.Characters HeckeGeneral.Analysis
open HeckeGeneral.ThetaSkeleton.Physical
open scoped Classical BigOperators nonZeroDivisors

variable (K : Type) [Field K] [NumberField K]

/-- The actual principal ideal generated by 6, with its nonzero proof. -/
def sixNonzeroIdeal : NonzeroIdeal K :=
  ⟨Ideal.span {(6 : 𝓞 K)}, mem_nonZeroDivisors_of_ne_zero (by
    simpa only [Ideal.span_singleton_eq_bot] using (show (6 : 𝓞 K) ≠ 0 by norm_num))⟩

lemma prime_dvd_sixNonzeroIdeal (p : HeightOneSpectrum (𝓞 K)) :
    p.asIdeal ∣ (sixNonzeroIdeal K).val ↔ (6 : 𝓞 K) ∈ p.asIdeal := by
  rw [Ideal.dvd_iff_le]
  exact Ideal.span_singleton_le_iff_mem

variable (S : Set (HeightOneSpectrum (𝓞 K))) [Fintype S]

/-- Fixed exceptional primes, primes above 6, and every complete-row prime. -/
def originalDeletedPrimes (u : NonzeroIdeal K) : Finset (HeightOneSpectrum (𝓞 K)) :=
  S.toFinset ∪ SquarefreeAmplification.idealPrimeSupport K (sixNonzeroIdeal K) ∪
    SquarefreeAmplification.idealPrimeSupport K u

lemma mem_originalDeletedPrimes (u : NonzeroIdeal K) (p : HeightOneSpectrum (𝓞 K)) :
    p ∈ originalDeletedPrimes K S u ↔
      p ∈ S ∨ (6 : 𝓞 K) ∈ p.asIdeal ∨ p.asIdeal ∣ u.val := by
  simp only [originalDeletedPrimes, Finset.mem_union, Set.mem_toFinset,
    SquarefreeAmplification.mem_idealPrimeSupport_iff, prime_dvd_sixNonzeroIdeal,
    or_assoc]

lemma isCoprime_of_no_common_prime_divisor (I u : NonzeroIdeal K)
    (h : ∀ p : HeightOneSpectrum (𝓞 K), p.asIdeal ∣ I.val → ¬ p.asIdeal ∣ u.val) :
    IsCoprime I.val u.val := by
  apply Ideal.coprime_of_no_prime_ge
  intro P hIP huP hP
  have hP0 : P ≠ ⊥ := by
    intro hz
    exact nonZeroDivisors.coe_ne_zero I (le_bot_iff.mp (hz ▸ hIP))
  let p : HeightOneSpectrum (𝓞 K) := ⟨P, hP, hP0⟩
  exact h p (Ideal.dvd_iff_le.mpr hIP) (Ideal.dvd_iff_le.mpr huP)

/-- The actual Boolean mask is exactly avoidance of the explicit deleted
prime set, even if a complete-row prime is unramified in the character. -/
theorem originalMask_iff_avoids (u I : NonzeroIdeal K) :
    completeIdealCommonMask K S u I.val = true ↔
      ∀ p ∈ originalDeletedPrimes K S u, ¬p.asIdeal ∣ I.val := by
  change decide ((∀ p : HeightOneSpectrum (𝓞 K), p.asIdeal ∣ I.val →
    p ∉ S ∧ (6 : 𝓞 K) ∉ p.asIdeal) ∧ IsCoprime I.val u.val) = true ↔ _
  rw [decide_eq_true_eq]
  constructor
  · rintro ⟨hgood, hcop⟩ p hp hdvd
    rcases (mem_originalDeletedPrimes K S u p).mp hp with hS | h6 | hu
    · exact (hgood p hdvd).1 hS
    · exact (hgood p hdvd).2 h6
    · have htop : (⊤ : Ideal (𝓞 K)) ≤ p.asIdeal := by
        rw [← hcop.sup_eq]
        exact sup_le (Ideal.dvd_iff_le.mp hdvd) (Ideal.dvd_iff_le.mp hu)
      exact p.isPrime.ne_top (top_le_iff.mp htop)
  · intro h
    constructor
    · intro p hp
      constructor
      · intro hS
        exact h p ((mem_originalDeletedPrimes K S u p).mpr (Or.inl hS)) hp
      · intro h6
        exact h p ((mem_originalDeletedPrimes K S u p).mpr (Or.inr (Or.inl h6))) hp
    · apply isCoprime_of_no_common_prime_divisor K I u
      intro p hp hu
      exact h p ((mem_originalDeletedPrimes K S u p).mpr (Or.inr (Or.inr hu))) hp

/-- Deleting prime values produces the literal all-ideal avoidance mask.
There is no squarefree restriction in this coefficient identity. -/
theorem idealCoefficient_deletePrimes_eq_mask
    (E : Finset (HeightOneSpectrum (𝓞 K)))
    (a : HeightOneSpectrum (𝓞 K) → ℂ) (I : NonzeroIdeal K) :
    nonzeroIdealCoefficient (IdealMobiusReciprocal.deletePrimes K E a) I =
      nonzeroIdealCoefficient a I *
        (if ∀ p ∈ E, ¬p.asIdeal ∣ I.val then (1 : ℂ) else 0) := by
  by_cases h : ∀ p ∈ E, ¬p.asIdeal ∣ I.val
  · rw [if_pos h, mul_one]
    apply idealCoefficient_congr_on_divisors
    intro p hp
    have hpE : p ∉ E := fun he => h p he hp
    simp [IdealMobiusReciprocal.deletePrimes, hpE]
  · rw [if_neg h, mul_zero]
    push_neg at h
    obtain ⟨p, hpE, hpI⟩ := h
    obtain ⟨J, hJ⟩ := hpI
    change idealCoefficient (IdealMobiusReciprocal.deletePrimes K E a) I.val = 0
    rw [hJ, idealCoefficient_mul, idealCoefficient_prime]
    simp [IdealMobiusReciprocal.deletePrimes, hpE]

/-- A genuine ideal-indexed multiplicative weight, retaining every zero. -/
def originalMaskedCoefficientHom (χ : HeckeCharacter K) (u : NonzeroIdeal K) :
    Ideal (𝓞 K) →*₀ ℂ :=
  idealCoefficientHom (IdealMobiusReciprocal.deletePrimes K
    (originalDeletedPrimes K S u) (primeCoefficient K χ))

/-- The arrow's values are exactly the common-mask values used by MomentData. -/
theorem originalMaskedCoefficientHom_eq (χ : HeckeCharacter K)
    (u I : NonzeroIdeal K) :
    originalMaskedCoefficientHom K S χ u I.val =
      heckeIdealCoefficient K χ I *
        (if completeIdealCommonMask K S u I.val then (1 : ℂ) else 0) := by
  change nonzeroIdealCoefficient
    (IdealMobiusReciprocal.deletePrimes K (originalDeletedPrimes K S u)
      (primeCoefficient K χ)) I = _
  rw [idealCoefficient_deletePrimes_eq_mask]
  rw [← originalMask_iff_avoids]
  rfl

theorem originalMaskedCoefficientHom_norm_le (χ : HeckeCharacter K)
    (u : NonzeroIdeal K) (I : Ideal (𝓞 K)) :
    ‖originalMaskedCoefficientHom K S χ u I‖ ≤ 1 :=
  norm_idealCoefficient_le_one _
    (IdealMobiusReciprocal.norm_deletePrimes_le_one K (originalDeletedPrimes K S u)
      (primeCoefficient K χ) (norm_primeCoefficient_le_one K χ)) I

/-- The reciprocal detector coefficient has the actual Moebius, the same
Hecke coefficient, and the same complete common mask. -/
theorem originalMaskedMobiusCoefficient_eq (χ : HeckeCharacter K)
    (u I : NonzeroIdeal K) :
    (moebius I.val : ℂ) * originalMaskedCoefficientHom K S χ u I.val =
      (moebius I.val : ℂ) * heckeIdealCoefficient K χ I *
        (if completeIdealCommonMask K S u I.val then (1 : ℂ) else 0) := by
  rw [originalMaskedCoefficientHom_eq, mul_assoc]

open HeckeGeneral.Analysis.ConditionalMoments HeckeGeneral.ThetaSkeleton.Global

variable (P : ProbeData K S) (R : RowCharacterInput K S P)
variable (ω ψ : HeckeCharacter K)

/-- The shared recipe's inverse sum is exactly the detector's multiplicative
masked coefficient sum, including the signed row character. -/
theorem shared_inversePolynomial_eq_maskedHom
    (a : PolynomialPresentation K ψ) (g : SlotGeometry K)
    (c : Fin g.slotCount → HeckeCharacter K) (V W : IdealTest K)
    (u : FrequencyRow K S) (D t : ℝ) :
    inversePolynomial (sharedMomentData K S P R ω ψ a g c u.sector V W)
      u.ideal.val D t =
      (Real.sqrt D : ℂ)⁻¹ *
        ∑ I ∈ V.support u.ideal.val t D,
          (moebius I.val : ℂ) *
            originalMaskedCoefficientHom K S
              (a.inverseBackground * R.character u ^ a.direction) u.ideal.val I.val *
            V.profile u.ideal.val t (idealNorm K I / D) := by
  unfold inversePolynomial
  change (Real.sqrt D : ℂ)⁻¹ *
      (∑ I ∈ V.support u.ideal.val t D,
        (moebius I.val : ℂ) * heckeIdealCoefficient K a.inverseBackground I *
          heckeIdealCoefficient K (completeIdealRowCharacter K S P R u.sector u.ideal.val) I ^
            a.direction * V.profile u.ideal.val t (idealNorm K I / D) *
          (if completeIdealCommonMask K S u.ideal.val I.val then (1 : ℂ) else 0)) = _
  rw [completeIdealRowCharacter_of_frequencyRow]
  congr 1
  apply Finset.sum_congr rfl
  intro I _hI
  rw [originalMaskedCoefficientHom_eq]
  have h := masked_background_signed_coefficient K S P R u I
    a.inverseBackground a.direction a.direction_spec
  calc
    _ = (moebius I.val : ℂ) *
        ((heckeIdealCoefficient K a.inverseBackground I *
          heckeIdealCoefficient K (R.character u) I ^ a.direction) *
            (if completeIdealCommonMask K S u.ideal.val I.val then (1 : ℂ) else 0)) *
        V.profile u.ideal.val t (idealNorm K I / D) := by ring
    _ = _ := by rw [h]

/-- The plain test has the very same deleted coefficient convention. -/
theorem shared_plainPolynomial_eq_maskedHom
    (a : PolynomialPresentation K ψ) (g : SlotGeometry K)
    (c : Fin g.slotCount → HeckeCharacter K) (V W : IdealTest K)
    (u : FrequencyRow K S) (N t : ℝ) :
    plainPolynomial (sharedMomentData K S P R ω ψ a g c u.sector V W) W
      u.ideal.val N t =
      (Real.sqrt N : ℂ)⁻¹ *
        ∑ I ∈ W.support u.ideal.val t N,
          originalMaskedCoefficientHom K S
            (a.plainBackground * R.character u) u.ideal.val I.val *
            W.profile u.ideal.val t (idealNorm K I / N) := by
  unfold plainPolynomial
  change (Real.sqrt N : ℂ)⁻¹ *
      (∑ I ∈ W.support u.ideal.val t N,
        heckeIdealCoefficient K
          (a.plainBackground * completeIdealRowCharacter K S P R u.sector u.ideal.val) I *
          W.profile u.ideal.val t (idealNorm K I / N) *
          (if completeIdealCommonMask K S u.ideal.val I.val then (1 : ℂ) else 0)) = _
  rw [completeIdealRowCharacter_of_frequencyRow]
  congr 1
  apply Finset.sum_congr rfl
  intro I _hI
  rw [originalMaskedCoefficientHom_eq]
  ring

end HeckeGeneral.Analysis.ExpansionRecipe
