import HeckeSkeleton.ExpansionModels.SharedWitnessRecipe

/-!
# The actual TIP amplitude object from finite detector choices

This is a data-and-assembly adapter, not the analytic detector existence
theorem.  A finite label records the chosen presentation and dyadic pair.
Continuous row parameters live inside the actual IdealTests and introduce
no further subdivision.  Both witness polynomials and every selected-slot
moment are generated by `WitnessRecipe`.

`cover_of_local_spikes` consumes explicit local numerical conclusions; it
does not claim those conclusions follow from a zero.  That analytic step is
kept separate and must be supplied by the genuine detector argument.
-/

set_option autoImplicit false
noncomputable section

namespace HeckeGeneral.Analysis.ExpansionRecipe

open NumberField IsDedekindDomain HeckeGeneral.Arithmetic HeckeGeneral.Characters
open HeckeGeneral.Analysis HeckeGeneral.Analysis.ConditionalMoments
open HeckeGeneral.ThetaSkeleton.Physical HeckeGeneral.ThetaSkeleton.TIP
open HeckeGeneral.ThetaSkeleton.Global
open scoped Classical BigOperators

variable (K : Type) [Field K] [NumberField K]
variable (S : Set (HeightOneSpectrum (𝓞 K))) [Fintype S]
variable (P : ProbeData K S) (R : RowCharacterInput K S P)
variable (ω ψ : HeckeCharacter K)

/-- The only finite witness label is its original presentation/dyadic label.
The recipe's `rows` field is overwritten by the exact chosen-label fiber. -/
structure FiniteWitnessChoice where
  count : ℝ → ℕ
  choice : (t : ℝ) → FrequencyRow K S → Fin (count t)
  recipe : (t : ℝ) → Fin (count t) → WitnessRecipe K S
  presentation : (t : ℝ) → Fin (count t) → PolynomialPresentation K ψ

variable {K S P R ω ψ}

def FiniteWitnessChoice.recipeOn (F : FiniteWitnessChoice K S ψ)
    (rows : Finset (FrequencyRow K S)) (t : ℝ) (j : Fin (F.count t)) :
    WitnessRecipe K S :=
  { F.recipe t j with rows := rows.filter fun u => F.choice t u = j }

def FiniteWitnessChoice.amplitudeSet (F : FiniteWitnessChoice K S ψ)
    (rows : Finset (FrequencyRow K S)) (g : SlotGeometry K)
    (amp : Fin g.slotCount → ℝ) (a₀ : PolynomialPresentation K ψ)
    (c : Fin g.slotCount → HeckeCharacter K) (U Z : ℝ) :
    AmplitudeSet (FrequencyRow K S) g.slotCount where
  rows := rows
  amplitude := amp
  slotValue := physicalSlotValue (P := P) (R := R) (ω := ω) a₀ g c Z
  subdivisionCount := F.count
  subdivision t j := (F.recipeOn rows t j).toWitness (P := P) (R := R) (ω := ω)
    (F.presentation t j) g c U

theorem FiniteWitnessChoice.subdivision_mem (F : FiniteWitnessChoice K S ψ)
    (rows : Finset (FrequencyRow K S)) (g : SlotGeometry K)
    (amp : Fin g.slotCount → ℝ) (a₀ : PolynomialPresentation K ψ)
    (c : Fin g.slotCount → HeckeCharacter K) (U Z t : ℝ)
    (j : Fin (F.count t)) (u : FrequencyRow K S) :
    u ∈ ((F.amplitudeSet (P := P) (R := R) (ω := ω) rows g amp a₀ c U Z).subdivision
      t j).rows ↔ u ∈ rows ∧ F.choice t u = j := by
  simp [FiniteWitnessChoice.amplitudeSet, FiniteWitnessChoice.recipeOn,
    WitnessRecipe.toWitness]

theorem FiniteWitnessChoice.subdivision_cover (F : FiniteWitnessChoice K S ψ)
    (rows : Finset (FrequencyRow K S)) (g : SlotGeometry K)
    (amp : Fin g.slotCount → ℝ) (a₀ : PolynomialPresentation K ψ)
    (c : Fin g.slotCount → HeckeCharacter K) (U Z t : ℝ) :
    ∀ u ∈ rows, ∃ j,
      u ∈ ((F.amplitudeSet (P := P) (R := R) (ω := ω) rows g amp a₀ c U Z).subdivision
        t j).rows := by
  intro u hu
  exact ⟨F.choice t u, (F.subdivision_mem rows g amp a₀ c U Z t _ u).mpr ⟨hu, rfl⟩⟩

/-- Prime slots are fixed by the physical geometry and coefficient family.
The finite presentation and the two actual witness tests cannot change them. -/
theorem physicalSlotValue_presentation_independent
    (a a' : PolynomialPresentation K ψ) (g : SlotGeometry K)
    (c : Fin g.slotCount → HeckeCharacter K) (Z : ℝ)
    (j : Fin g.slotCount) (u : FrequencyRow K S) :
    physicalSlotValue (P := P) (R := R) (ω := ω) a g c Z j u =
      physicalSlotValue (P := P) (R := R) (ω := ω) a' g c Z j u := rfl

/-- All selected-slot and independent unmarked polynomial identities for
the actual `AmplitudeSet` constructor, rather than an abstract replacement. -/
theorem FiniteWitnessChoice.amplitude_calibration (F : FiniteWitnessChoice K S ψ)
    (rows : Finset (FrequencyRow K S)) (g : SlotGeometry K)
    (amp : Fin g.slotCount → ℝ) (a₀ : PolynomialPresentation K ψ)
    (c : Fin g.slotCount → HeckeCharacter K) (d : ℝ) (hd : 0 < d)
    {Z : ℝ} (hZ : 0 < Z) (t : ℝ) (j : Fin (F.count t))
    (J : Finset (Fin g.slotCount)) (u : FrequencyRow K S) :
    let A := F.amplitudeSet (P := P) (R := R) (ω := ω) rows g amp a₀ c (Z ^ d) Z
    let w := F.recipeOn rows t j
    let M := w.selectedModel (P := P) (R := R) (ω := ω)
      (F.presentation t j) g c d hd J u.sector
    let M₀ := w.unmarkedModel (P := P) (R := R) (ω := ω)
      (F.presentation t j) g c u.sector
    (A.subdivision t j).inverseValue u = inversePolynomial M u.ideal.val
      ((Z ^ d) ^ (A.subdivision t j).inverseLength) 0 ∧
    (A.subdivision t j).plainValue u = plainPolynomial M M.plainTest₁ u.ideal.val
      ((Z ^ d) ^ (A.subdivision t j).plainLength) 0 ∧
    (A.subdivision t j).plainValue u = plainPolynomial M M.plainTest₂ u.ideal.val
      ((Z ^ d) ^ (A.subdivision t j).plainLength) 0 ∧
    (∏ k ∈ J, A.slotValue k u) = slotProduct M u.ideal.val (Z ^ d) 0 ∧
    (A.subdivision t j).inverseValue u = inversePolynomial M₀ u.ideal.val
      ((Z ^ d) ^ (A.subdivision t j).inverseLength) 0 := by
  exact (F.recipeOn rows t j).polynomial_calibration
    (P := P) (R := R) (ω := ω) (F.presentation t j) g c d hd J hZ u

/-- Pure assembly of a cover from the local detector's explicitly displayed
length and spike conclusions.  It is not an analytic existence theorem. -/
theorem FiniteWitnessChoice.cover_of_local_spikes (F : FiniteWitnessChoice K S ψ)
    (rows : Finset (FrequencyRow K S)) (g : SlotGeometry K)
    (amp : Fin g.slotCount → ℝ) (a₀ : PolynomialPresentation K ψ)
    (c : Fin g.slotCount → HeckeCharacter K) (U Z t δ lam k : ℝ)
    (hcount : (F.count t : ℝ) ≤ k * U ^ lam)
    (hlength : ∀ j : Fin (F.count t),
      0 ≤ (F.recipe t j).inverseLength ∧ 0 ≤ (F.recipe t j).plainLength ∧
      (F.recipe t j).inverseLength ≤ t + lam ∧
      t - lam ≤ (F.recipe t j).inverseLength + (F.recipe t j).plainLength)
    (hspike : ∀ u ∈ rows,
      let j := F.choice t u
      let W := (F.recipe t j).toWitness (P := P) (R := R) (ω := ω)
        (F.presentation t j) g c U
      U ^ (δ * W.inverseLength - lam) ≤ ‖W.inverseValue u‖ ^ 2 ∧
      U ^ (δ * W.plainLength - lam) ≤ ‖W.plainValue u‖ ^ 2) :
    WitnessCover (F.amplitudeSet (P := P) (R := R) (ω := ω) rows g amp a₀ c U Z)
      t δ U lam k := by
  refine ⟨hcount, F.subdivision_cover rows g amp a₀ c U Z t, ?_⟩
  intro j
  refine ⟨?_, (hlength j).1, (hlength j).2.1, (hlength j).2.2.1,
    (hlength j).2.2.2, ?_, ?_⟩
  · intro u hu
    exact ((F.subdivision_mem rows g amp a₀ c U Z t j u).mp hu).1
  · intro u hu
    obtain ⟨hu', hj⟩ := (F.subdivision_mem rows g amp a₀ c U Z t j u).mp hu
    have h := (hspike u hu').1
    simpa only [hj] using h
  · intro u hu
    obtain ⟨hu', hj⟩ := (F.subdivision_mem rows g amp a₀ c U Z t j u).mp hu
    have h := (hspike u hu').2
    simpa only [hj] using h

end HeckeGeneral.Analysis.ExpansionRecipe
