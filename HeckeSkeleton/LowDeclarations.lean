import HeckeSkeleton.LowHybrid
import HeckeSkeleton.LowFrozenCube

/-! Export elaborated theorem types, including all section and typeclass
parameters. This is documentation generated by Lean from the checked
environment; it does not add assumptions or mathematical declarations. -/

set_option format.width 100
set_option pp.universes true
set_option pp.fullNames true
set_option pp.proofs true
set_option pp.deepTerms true
set_option pp.maxSteps 10000000

open Lean Elab Command in
run_cmd do
  let env ← getEnv
  let names := (env.constants.toList.filterMap fun (name, info) =>
    let userName := privateToUserName name
    if info.isTheorem &&
      ((`HeckeSkeleton.LowHybrid).isPrefixOf userName ||
       (`HeckeSkeleton.LowFrozenCube).isPrefixOf userName)
    then some name else none).toArray.qsort Name.lt
  for name in names do
    let some info := env.find? name | throwError "Missing declaration {name}"
    logInfo m!"DECLARATION {privateToUserName name}\nINTERNAL {name}\nTYPE {info.type}\nEND_DECLARATION"
  logInfo m!"DECLARATION TYPES EXPORTED: {names.size}."
