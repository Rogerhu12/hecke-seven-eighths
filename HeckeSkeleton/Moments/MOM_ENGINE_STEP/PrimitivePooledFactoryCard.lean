namespace PrimitivePassiveFactoryCard

/-- One fixed bound for the main source and the three amplified tags. -/
def allTagsConstant (K : Type) [Field K] [NumberField K]
    (cap : ℕ) (columnBound primeBound ε : ℝ)
    (hcolumnBound : 0 ≤ columnBound) (hprimeBound : 0 ≤ primeBound) (hε : 0 < ε) : ℝ :=
  max (directConstant K cap columnBound ε hcolumnBound hε)
    (poolConstant K cap columnBound primeBound ε hcolumnBound hprimeBound hε)

theorem allTagsConstant_pos (K : Type) [Field K] [NumberField K]
    (cap : ℕ) (columnBound primeBound ε : ℝ)
    (hcolumnBound : 0 ≤ columnBound) (hprimeBound : 0 ≤ primeBound) (hε : 0 < ε) :
    0 < allTagsConstant K cap columnBound primeBound ε hcolumnBound hprimeBound hε :=
  (directConstant_pos K cap columnBound ε hcolumnBound hε).trans_le (le_max_left _ _)

end PrimitivePassiveFactoryCard

