/-!
# The unified child step of the paired fourth-moment engine

The same statement handles every finite number of live slots.  Starting
with the actual child `MomentData`, the explicit two-transform length
formulas imply a strict effective-width drop.  One whole-slot removal then
gives a successor with either no slots or the required capacity, together
with a bound on the actual energy.  Its cost is paid by
`b₂ - p₂ + w + B + ell`, including the pool density exactly once.

The other modules expose the exact whole-coefficient identities, full
nonprimitive correlation transform, actual local amplifier table and
prime-ideal pool pushforward.  The induction task can use
`paired_child_step` without splitting its proof by slot count.

This child theorem does not assert that the parent moment has already
been decomposed into a finite collection of these children.  That analytic
assembly must also control common-kernel tails and exceptional children.
-/

noncomputable section
open scoped Classical BigOperators

namespace HeckeSkeleton.Moments.EngineStep

open NumberField HeckeGeneral.Characters
open HeckeGeneral.Analysis HeckeGeneral.Analysis.ConditionalMoments

variable {K : Type} [Field K] [NumberField K]
variable {ω ψ : HeckeCharacter K}

/-- A uniform strict-width and capacity step on the actual finite energy.
The bounds on prime factors are quantified after the successor is chosen,
so the choice is independent of the row, scale and prime-factor values. -/
theorem paired_child_step (dChild : MomentData K ω ψ) (a : RealParameters)
    (A m q c d R E Krow w wo g g₂ t₂ V b₂ p₂ B ell σ δ mesh err : ℝ)
    (hσ : 0 < σ) (hκ : 0 < a.κ) (hmesh : 0 ≤ mesh)
    (hfit : dChild.geometry.fitsMesh mesh) (hz : a.z = dChild.geometry.totalLength)
    (hprincipal : ∀ u : NonzeroIdeal K,
      dChild.plainBackground * dChild.rowCharacter u = 1 →
        dChild.rowCharacter u ∈ dChild.theta)
    (henlarge : d - c + (2 * A - c - d + R + E - m - Krow) -
      2 * w + wo + σ ≤ g)
    (hcommon : t₂ ≤ g₂)
    (hactual : a.m + a.q ≤
      (2 * (A - c - w) - Krow - g - g₂ - V) +
      (q + R + E + wo + t₂ + V) + δ)
    (hδ : δ ≤ σ / 2) (hbp : p₂ ≤ b₂) (hB : 0 ≤ B)
    (hcharge : 0 ≤ (b₂ - p₂ + w + B + ell) + err / 6 + a.κ * mesh)
    (hdefect : dChild.geometry.slotCount = 0 ∨
      max (a.n₁ + a.n₂ + 6 * a.κ * a.z - (a.m + a.q)) 0 ≤
        6 * (w + ell) + err) :
    a.m + a.q ≤ m + q - σ / 2 ∧ a.m + a.q < m + q ∧
    ∃ removed : Finset (Fin dChild.geometry.slotCount),
      let keep := Finset.univ \ removed
      let a' := remainingParameters dChild a keep
      (a'.z = 0 ∨ a.n₁ + a.n₂ + 6 * a.κ * a'.z ≤ a.m + a.q) ∧
      ∀ Z : ℝ, 1 ≤ Z → ∀ C : Fin dChild.geometry.slotCount → ℝ,
        (∀ i, 0 ≤ C i) → ∀ t : ℝ,
        (∀ u ∈ pairedRows dChild a Z, ∀ i,
          ‖primePolynomial dChild i u Z t‖ ^ 2 ≤
            C i * Z ^ (a.κ * (dChild.geometry.slots i).length)) →
        pairedEnergy dChild a Z t ≤
          (∏ i ∈ removed, C i) *
            Z ^ ((b₂ - p₂ + w + B + ell) + err / 6 + a.κ * mesh) *
              pairedEnergy (dChild.restrictSlots keep) a' Z t := by
  have hid := child_width_identity A m q c d R E Krow w wo g g₂ t₂ V
  dsimp only at hid
  have hdrop : a.m + a.q ≤ m + q - σ / 2 := by linarith
  refine ⟨hdrop, by linarith, ?_⟩
  apply actual_paired_capacity_step_or_zero dChild a mesh (b₂ - p₂ + w + B + ell) err
    hκ hmesh hfit hz hprincipal hcharge
  have hallow := child_allowance_lower b₂ p₂ w B ell hbp hB
  rcases hdefect with hzero | hdefect
  · exact Or.inl hzero
  · exact Or.inr (by linarith)

end HeckeSkeleton.Moments.EngineStep

#print axioms HeckeSkeleton.Moments.EngineStep.paired_child_step

