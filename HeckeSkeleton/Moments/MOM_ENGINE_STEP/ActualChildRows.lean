import HeckeSkeleton.Moments.MOM_ENGINE_STEP.ActualFrequencyPartition
import HeckeSkeleton.Moments.MOM_ENGINE_STEP.GeneratedCorrelation
import HeckeSkeleton.Moments.MOM_ENGINE_STEP.ChildTermDictionary

/-!
# Actual extracted row ideals in the child moment

The row index below is the exterior ideal generated by the extracted
frequency, converted to the repository's genuine nonzero ideal type.
Its norm cutoff follows from the exact common-factor norm identity.
Its allowed-row and exceptional-character conditions are the raw source
conditions on the actual child `MomentData`; they are not replaced by an
arbitrary finite row set or inferred from finite-order characters.

The final comparison consumes only individual coefficient/profile
dictionaries and row fibers.  The polynomial equality and the energy
comparison are both proved internally.
-/

noncomputable section
open scoped NumberField Classical BigOperators nonZeroDivisors
open NumberField IsDedekindDomain

namespace HeckeSkeleton.Moments.EngineStep

open DedekindZetaZeroFree HeckeGeneral.Characters
open HeckeGeneral.Analysis HeckeGeneral.Analysis.ConditionalMoments
open HeckePort.Moments LocalFiniteSums

variable {F : Type} [Field F] [NumberField F]
variable {A : SArithmeticData F} {σ : F →+* ℂ}
variable {η : RayClassCharacter F A.modulus} {hS : A.ContainsTraceBadPlaces}

def exteriorMomentIdeal (I : A.Exterior) : HeckeGeneral.Analysis.NonzeroIdeal F :=
  ⟨I.val, mem_nonZeroDivisors_of_ne_zero I.property.1⟩

theorem exteriorMomentIdeal_injective : Function.Injective (exteriorMomentIdeal (A := A)) := by
  intro I J h
  apply Subtype.ext
  exact congrArg (fun x : HeckeGeneral.Analysis.NonzeroIdeal F => x.val) h

@[simp] theorem idealNorm_exteriorMomentIdeal (I : A.Exterior) :
    HeckeGeneral.Analysis.idealNorm F (exteriorMomentIdeal I) = A.exteriorNorm I := rfl

/-- An actual extracted frequency and its genuine residual ideal. -/
structure ActualChildRow (Ih : A.Exterior) (h g : A.R) (Q : ℝ) where
  ideal : A.Exterior
  element : A.R
  generates : A.Generates ideal element
  frequency : h = g * element
  norm_factor : A.exteriorNorm Ih = Q * A.exteriorNorm ideal

namespace ActualChildRow

variable {Ih : A.Exterior} {h g : A.R} {Q : ℝ}

def momentIdeal (r : ActualChildRow Ih h g Q) : HeckeGeneral.Analysis.NonzeroIdeal F :=
  exteriorMomentIdeal r.ideal

theorem factor_pos (r : ActualChildRow Ih h g Q) : 0 < Q := by
  have hI := HeckeGeneral.Analysis.idealNorm_pos F (exteriorMomentIdeal Ih)
  have hr := HeckeGeneral.Analysis.idealNorm_pos F (exteriorMomentIdeal r.ideal)
  rw [idealNorm_exteriorMomentIdeal] at hI hr
  have hprod : 0 < Q * A.exteriorNorm r.ideal := by rwa [← r.norm_factor]
  exact (mul_pos_iff_of_pos_right hr).mp hprod

theorem norm_le (r : ActualChildRow Ih h g Q) (X : ℝ)
    (hX : A.exteriorNorm Ih ≤ Q * X) :
    HeckeGeneral.Analysis.idealNorm F r.momentIdeal ≤ X := by
  change A.exteriorNorm r.ideal ≤ X
  apply le_of_mul_le_mul_left _ r.factor_pos
  rwa [← r.norm_factor]

theorem mem_pairedRows {ω ψ : HeckeCharacter F}
    (r : ActualChildRow Ih h g Q) (d : MomentData F ω ψ) (a : RealParameters) (Z : ℝ)
    (hallowed : d.allowedRow r.momentIdeal)
    (hcutoff : A.exteriorNorm Ih ≤ Q * Z ^ (a.m + a.q))
    (hexception : if a.z = 0 then d.plainBackground * d.rowCharacter r.momentIdeal ≠ 1
      else d.rowCharacter r.momentIdeal ∉ d.theta) :
    r.momentIdeal ∈ pairedRows d a Z := by
  apply Finset.mem_filter.mpr
  exact ⟨(d.rows_spec _ _).mpr ⟨hallowed, r.norm_le _ hcutoff⟩, hexception⟩

end ActualChildRow

/-- The genuine complete correlation constructs such a row.  The
frequency multiplier is literally the gcd generator times the selected
nonunit radical generator. -/
theorem exists_actual_extracted_child_row {ι : Type*} [Fintype ι] [DecidableEq ι]
    (C : A.GeneralArithmeticContext σ η hS)
    (p : ι → ExteriorPrime A) (hp : Function.Injective p) (m n : ι → ℕ)
    (Ih : A.Exterior) (h : A.R) (hh : A.Generates Ih h)
    (hne : generatedIdealCorrelation (σ := σ) (primePowerProduct p m) (primePowerProduct p n)
      (primePowerProductGenerator C p m) (primePowerProductGenerator C p n)
      (primePowerProduct_generates C p m) (primePowerProduct_generates C p n) h ≠ 0) :
    Nonempty (ActualChildRow Ih h
      (primePowerProductGenerator C p (fun i => min (m i) (n i)) *
        nonunitFrequencyGenerator C p m n h)
      ((Ideal.absNorm (gcd (primePowerProduct p m).val (primePowerProduct p n).val) : ℝ) *
        A.exteriorNorm (nonunitFrequencyRadical C p m n h))) := by
  obtain ⟨h', I', hgen, hfreq, _hideal, hnorm⟩ :=
    actual_product_correlation_frequency_ideal_extract C p hp m n Ih h hh hne
  exact ⟨⟨I', h', hgen, hfreq, hnorm⟩⟩

/-- Independently chosen generators of the actual two common ideals
produce the same extracted row, with the original frequency unchanged. -/
theorem exists_actual_extracted_child_row_of_generates
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    (C : A.GeneralArithmeticContext σ η hS)
    (p : ι → ExteriorPrime A) (hp : Function.Injective p) (m n : ι → ℕ)
    (a b : A.R) (ha : A.Generates (primePowerProduct p m) a)
    (hb : A.Generates (primePowerProduct p n) b)
    (Ih : A.Exterior) (h : A.R) (hh : A.Generates Ih h)
    (hne : generatedIdealCorrelation (σ := σ) (primePowerProduct p m) (primePowerProduct p n)
      a b ha hb h ≠ 0) :
    Nonempty (ActualChildRow Ih h
      (primePowerProductGenerator C p (fun i => min (m i) (n i)) *
        nonunitFrequencyGenerator C p m n h)
      ((Ideal.absNorm (gcd (primePowerProduct p m).val (primePowerProduct p n).val) : ℝ) *
        A.exteriorNorm (nonunitFrequencyRadical C p m n h))) := by
  obtain ⟨h', I', hgen, hfreq, _hideal, hnorm⟩ :=
    actual_product_correlation_frequency_ideal_extract_of_generates
      C p hp m n a b ha hb Ih h hh hne
  exact ⟨⟨I', h', hgen, hfreq, hnorm⟩⟩

section Energy

variable {ω ψ : HeckeCharacter F}
variable {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℝ V]

/-- Direct application of the actual single-term dictionaries to a whole
child energy.  The exact `pairedRows` filter is proved from the raw row
predicate, norm factorization and actual exceptional status.  In
particular no aggregate `hpoly` premise remains. -/
theorem actual_child_energy_from_terms {H : Type*}
    (rows : Finset H) (Ih : H → A.Exterior) (h g : H → A.R) (Q : H → ℝ)
    (r : ∀ k, ActualChildRow (Ih k) (h k) (g k) (Q k))
    (d : MomentData F ω ψ) (a : RealParameters) (Z t : ℝ)
    (D : ∀ k, ChildHeckeTermDictionary (σ := σ) d (r k).momentIdeal (g k) (r k).element)
    (S₁ S₂ : Finset (HeckeGeneral.Analysis.NonzeroIdeal F))
    (S : Fin d.geometry.slotCount → Finset (HeightOneSpectrum (𝓞 F)))
    (hS₁ : ∀ k ∈ rows, d.plainTest₁.support (r k).momentIdeal t (Z ^ a.n₁) ⊆ S₁)
    (hS₂ : ∀ k ∈ rows, d.plainTest₂.support (r k).momentIdeal t (Z ^ a.n₂) ⊆ S₂)
    (hS : ∀ i, (d.geometry.slots i).support t (Z ^ (d.geometry.slots i).length) ⊆ S i)
    (w₁ w₂ : H → HeckeGeneral.Analysis.NonzeroIdeal F → ℂ)
    (w : H → Fin d.geometry.slotCount → HeightOneSpectrum (𝓞 F) → ℂ)
    (x₁ x₂ : H → HeckeGeneral.Analysis.NonzeroIdeal F → V)
    (x : H → Fin d.geometry.slotCount → HeightOneSpectrum (𝓞 F) → V) (ξ : V)
    (hW₁ : ∀ k ∈ rows, ∀ I ∈ S₁, w₁ k I * jointPhase ξ (x₁ k I) =
      d.plainTest₁.profile (r k).momentIdeal t (HeckeGeneral.Analysis.idealNorm F I / Z ^ a.n₁))
    (hW₂ : ∀ k ∈ rows, ∀ I ∈ S₂, w₂ k I * jointPhase ξ (x₂ k I) =
      d.plainTest₂.profile (r k).momentIdeal t (HeckeGeneral.Analysis.idealNorm F I / Z ^ a.n₂))
    (hW : ∀ k ∈ rows, ∀ i, ∀ p ∈ S i, w k i p * jointPhase ξ (x k i p) =
      (d.geometry.slots i).profile t
        ((Ideal.absNorm p.asIdeal : ℝ) / Z ^ (d.geometry.slots i).length))
    (q : H → ℂ) (W : ℝ) (B : ℕ) (hWnonneg : 0 ≤ W)
    (hweight : ∀ k ∈ rows, ‖q k‖ ≤ W)
    (hallowed : ∀ k ∈ rows, d.allowedRow (r k).momentIdeal)
    (hcutoff : ∀ k ∈ rows, A.exteriorNorm (Ih k) ≤ Q k * Z ^ (a.m + a.q))
    (hexception : ∀ k ∈ rows,
      if a.z = 0 then d.plainBackground * d.rowCharacter (r k).momentIdeal ≠ 1
      else d.rowCharacter (r k).momentIdeal ∉ d.theta)
    (hfiber : ∀ u : HeckeGeneral.Analysis.NonzeroIdeal F,
      (rows.filter (fun k => (r k).momentIdeal = u)).card ≤ B) :
    jointColumnEnergy rows (childCartesianColumns S₁ S₂ S) q
      (fun k => childCartesianCoefficient
        (sourcePlainTerm (σ := σ) (D k).sourcePlain (D k).plainTwist (D k).sourceMask
          (g k) (r k).element (w₁ k) (Z ^ a.n₁))
        (sourcePlainTerm (σ := σ) (D k).sourcePlain (D k).plainTwist (D k).sourceMask
          (g k) (r k).element (w₂ k) (Z ^ a.n₂))
        (fun i => sourcePrimeTerm (σ := σ) ((D k).sourceSlot i) ((D k).slotTwist i)
          (D k).sourceMask (g k) (r k).element (w k i) (Z ^ (d.geometry.slots i).length)))
      (fun k => childCartesianLocation (x₁ k) (x₂ k) (x k)) ξ ≤
      W * (B : ℝ) * pairedEnergy d a Z t := by
  let P : HeckeGeneral.Analysis.NonzeroIdeal F → ℂ := fun u =>
    plainPolynomial d d.plainTest₁ u (Z ^ a.n₁) t *
      plainPolynomial d d.plainTest₂ u (Z ^ a.n₂) t * slotProduct d u Z t
  have hpoly (k : H) (hk : k ∈ rows) :=
    actual_child_polynomial_from_terms d (r k).momentIdeal (g k) (r k).element (D k)
      (Z ^ a.n₁) (Z ^ a.n₂) Z t S₁ S₂ S (hS₁ k hk) (hS₂ k hk) hS
      (w₁ k) (w₂ k) (w k) (x₁ k) (x₂ k) (x k) ξ
      (hW₁ k hk) (hW₂ k hk) (hW k hk)
  have hrows (k : H) (hk : k ∈ rows) : (r k).momentIdeal ∈ pairedRows d a Z :=
    (r k).mem_pairedRows d a Z (hallowed k hk) (hcutoff k hk) (hexception k hk)
  have hmass (u : HeckeGeneral.Analysis.NonzeroIdeal F) :
      (∑ k ∈ rows with (r k).momentIdeal = u, ‖q k‖) ≤ W * (B : ℝ) := by
    calc
      _ ≤ ∑ _k ∈ rows with (r _k).momentIdeal = u, W :=
        Finset.sum_le_sum (fun k hk => hweight k (Finset.mem_filter.mp hk).1)
      _ = ((rows.filter (fun k => (r k).momentIdeal = u)).card : ℝ) * W := by simp
      _ ≤ (B : ℝ) * W := mul_le_mul_of_nonneg_right (Nat.cast_le.mpr (hfiber u)) hWnonneg
      _ = _ := mul_comm _ _
  have hb := weightedEnergy_fiber_bound rows (pairedRows d a Z) (fun k => (r k).momentIdeal)
    (fun k => ‖q k‖) (fun _ => W * (B : ℝ)) P hrows (fun u _ => hmass u)
  have he : jointColumnEnergy rows (childCartesianColumns S₁ S₂ S) q
      (fun k => childCartesianCoefficient
        (sourcePlainTerm (σ := σ) (D k).sourcePlain (D k).plainTwist (D k).sourceMask
          (g k) (r k).element (w₁ k) (Z ^ a.n₁))
        (sourcePlainTerm (σ := σ) (D k).sourcePlain (D k).plainTwist (D k).sourceMask
          (g k) (r k).element (w₂ k) (Z ^ a.n₂))
        (fun i => sourcePrimeTerm (σ := σ) ((D k).sourceSlot i) ((D k).slotTwist i)
          (D k).sourceMask (g k) (r k).element (w k i) (Z ^ (d.geometry.slots i).length)))
      (fun k => childCartesianLocation (x₁ k) (x₂ k) (x k)) ξ =
      weightedEnergy rows (fun k => ‖q k‖) (fun k => P (r k).momentIdeal) := by
    unfold jointColumnEnergy weightedEnergy
    apply Finset.sum_congr rfl
    intro k hk
    rw [hpoly k hk]
  rw [he]
  simpa only [weightedEnergy, pairedEnergy, Finset.mul_sum, P, Function.comp_apply] using hb

end Energy

end HeckeSkeleton.Moments.EngineStep

