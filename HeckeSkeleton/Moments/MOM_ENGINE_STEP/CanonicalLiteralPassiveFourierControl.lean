variable (W : d.ProfileData) (B : ActualColumnAllocation K k)
variable (F : CanonicalLiteralPhaseCalibration.FixedPhases A)
variable (parent : MomentData K ω ψ) (oldMoving : OriginalMovingFactors A P R)
variable (correction : HeckeCharacter K) (hcorr : correction ∈ parent.theta)
variable {η : RayClassCharacter K A.modulus} {hS : A.ContainsTraceBadPlaces}
variable {ι : Type*} [Fintype ι] [DecidableEq ι]
variable (C : A.GeneralArithmeticContext σ η hS) (primes : ι → ExteriorPrime A)
variable (leftMultiplicity rightMultiplicity : ι → ℕ) (pattern : ι → Bool)
variable (sector : SixthUnitClasses K (A.Sf : Set (HeightOneSpectrum (𝓞 K))))
variable (remaining extra : HeckeGeneral.Analysis.NonzeroIdeal K) (m q : ℝ)
variable (inverse : IdealTest K) (index : Fin k → Fin parent.geometry.slotCount)
variable (rectangle : Bool) (firstSign : ℝ) (negative : Bool)

/-- The original profiles are read before modulation. The allocation
is the same stored allocation used in the actual calibration. -/
def originalLogProfiles : CanonicalLogProfiles.OriginalLogProfiles K ω ψ
    (WithLp 2 (ℝ × ℝ)) where
  original :=
    (CanonicalAppendedPhaseCalibration.childData P R parent (F.moving P R oldMoving)
      correction hcorr C primes leftMultiplicity rightMultiplicity pattern sector
      (remaining * extra) (d.base ^ (m + q)) inverse (W.left rectangle) (W.right rectangle)
      { slotCount := k, slots := W.slot } index).restrictSlots B.keep
  left := CanonicalLiteralProfileData.fourierAtom (d.scale₁ rectangle)
    (d.scale₁_pos rectangle) firstSign negative
  right := CanonicalLiteralProfileData.fourierAtom (d.scale₂ rectangle)
    (d.scale₂_pos rectangle) firstSign negative
  slot i := CanonicalLiteralProfileData.fourierAtom
    (d.base ^ d.length (SlotRestriction.index B.keep i))
    (Real.rpow_pos_of_pos (zero_lt_one.trans d.base_gt_one) _) firstSign negative
  left_positive := W.left_positive rectangle
  right_positive := W.right_positive rectangle
  slot_positive i := W.slot_positive (SlotRestriction.index B.keep i)

/-- Every arithmetic field, including the exhaustive row enumeration,
is unchanged by the literal profile update. -/
@[simp] theorem originalLogProfiles_moving (ξ : WithLp 2 (ℝ × ℝ)) :
    (originalLogProfiles P R W B F parent oldMoving correction hcorr C primes
      leftMultiplicity rightMultiplicity pattern sector remaining extra m q inverse index
      rectangle firstSign negative).moving ξ =
    data P R W B F parent oldMoving correction hcorr C primes leftMultiplicity
      rightMultiplicity pattern sector remaining extra m q inverse index rectangle
      firstSign negative ξ := rfl

end CanonicalLiteralAllocatedData

