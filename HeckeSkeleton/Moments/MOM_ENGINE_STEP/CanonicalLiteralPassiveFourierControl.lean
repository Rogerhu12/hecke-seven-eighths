/-- The original unmodulated table constructs all finite-atom fields
for the already chosen children. The four radius orders and the exact
capacity amplitudes are inherited from the same actual family. -/
def literalPassiveNormalizedFamily_fourierControl :
    ∀ analyticLeft analyticRight heightLeft heightRight,
      (production analyticLeft analyticRight heightLeft heightRight).FourierAtomControl
        (Finset.univ : Finset Labels)
        (orders.sup Prod.snd) (orders.sup Prod.snd)
        (orders.sup Prod.snd) (orders.sup Prod.snd) := by
  intro analyticLeft analyticRight heightLeft heightRight
  let family := production analyticLeft analyticRight heightLeft heightRight
  let leftLog : Labels → CanonicalLogProfiles.OriginalLogProfiles K ω ψ
      (WithLp 2 (ℝ × ℝ)) := fun b =>
    CanonicalLiteralAllocatedData.originalLogProfiles
      (P := P) (R := Rchar)
      (W := CanonicalLiteralPassiveSource.profiles leftTests leftAllocation A leftPaid)
      (B := passiveLeft b) (F := choice.phases) (parent := parent)
      (oldMoving := oldMoving) (correction := correction) (hcorr := hcorr)
      (C := C) (primes := (ordinaryRows).primes)
      (leftMultiplicity := (ordinaryRows).leftMultiplicity)
      (rightMultiplicity := (ordinaryRows).rightMultiplicity)
      (pattern := pattern) (sector := sector) (remaining := remaining) (extra := 1)
      (m := m) (q := q)
      (inverse := CanonicalLiteralProfileData.frozenNormTest parent.inverseTest reference time)
      (index := fun i => leftRecipe.slots.index (SlotRestriction.index (leftAllocation).keep i))
      (rectangle := b.1.2) (firstSign := firstSign) (negative := false)
  let rightLog : Labels → CanonicalLogProfiles.OriginalLogProfiles K ω ψ
      (WithLp 2 (ℝ × ℝ)) := fun b =>
    CanonicalLiteralAllocatedData.originalLogProfiles
      (P := P) (R := Rchar)
      (W := CanonicalLiteralPassiveSource.profiles rightTests rightAllocation A rightPaid)
      (B := passiveRight b) (F := choice.phases) (parent := parent)
      (oldMoving := oldMoving) (correction := correction) (hcorr := hcorr)
      (C := C) (primes := (ordinaryRows).primes)
      (leftMultiplicity := (ordinaryRows).leftMultiplicity)
      (rightMultiplicity := (ordinaryRows).rightMultiplicity)
      (pattern := pattern) (sector := sector) (remaining := remaining) (extra := 1)
      (m := m) (q := q)
      (inverse := CanonicalLiteralProfileData.frozenNormTest parent.inverseTest reference time)
      (index := fun i => rightRecipe.slots.index (SlotRestriction.index (rightAllocation).keep i))
      (rectangle := b.2.2) (firstSign := -firstSign) (negative := true)
  have hleftData (b : Labels) (ξ : WithLp 2 (ℝ × ℝ)) :
      (family.leftCalibration b).data ξ = (leftLog b).moving ξ := rfl
  have hrightData (b : Labels) (ξ : WithLp 2 (ℝ × ℝ)) :
      (family.rightCalibration b).data ξ = (rightLog b).moving ξ := rfl
  have hfactor : 0 ≤ analyticFactor := zero_le_one.trans
    (CanonicalFullKappaPrime.one_le_radiusFactor
      (K := K) Z δ mesh (CanonicalHeckePrimeAnalytic.degreeBound K) analyticHeight
      (CompleteMovingRowRecipe.primeMaskLogBound A Z (m + q)) domain.scale.le hδ.le hmesh)
  have hleftCoefficient (b : Labels) : 0 ≤ leftCoefficient b :=
    (leftComputed.passiveTable leftAllocation A leftPaid).coefficient_nonneg Z _ domain.scale.le
      isCompact_Icc (CanonicalLogProfiles.positiveAnnulus lo hi hlo) firstSign b.1.2
  have hrightCoefficient (b : Labels) : 0 ≤ rightCoefficient b :=
    (rightComputed.passiveTable rightAllocation A rightPaid).coefficient_nonneg Z _ domain.scale.le
      isCompact_Icc (CanonicalLogProfiles.positiveAnnulus lo hi hlo) (-firstSign) b.2.2
  exact CanonicalLogProfiles.familyFourierControl family Finset.univ
    leftLog rightLog (fun _ => 0) (fun _ => 0)
    hleftData hrightData (fun _ _ => rfl) (fun _ _ => rfl)
    (fun b => CanonicalFullKappaPrime.enlargedCoefficient (leftCoefficient b) analyticFactor)
    (fun b => CanonicalFullKappaPrime.enlargedCoefficient (rightCoefficient b) analyticFactor)
    (fun b _ => CanonicalFullKappaPrime.enlargedCoefficient_nonneg (hleftCoefficient b) hfactor)
    (fun b _ => CanonicalFullKappaPrime.enlargedCoefficient_nonneg (hrightCoefficient b) hfactor)
    (orders.sup Prod.snd) (orders.sup Prod.snd) (orders.sup Prod.snd) (orders.sup Prod.snd)
    (fun b _ z => leftRadiusProof analyticLeft analyticRight heightLeft heightRight b z)
    (fun b _ z => rightRadiusProof analyticLeft analyticRight heightLeft heightRight b z)

end ActualGaussStage.CoveredClassKey
