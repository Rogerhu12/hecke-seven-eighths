set_option autoImplicit false
set_option relaxedAutoImplicit false

/-!
# The original multiplicity at a multiplicity-one nonunit prime

The active factor is the original singleton generated by the second
frequency extraction. Its exact complete character, together with the
actual residual-row character, detects the original frequency exponent.
At a multiplicity-one nonunit prime extraction removes exactly two
copies. No global multiplicativity axiom for chosen generators is used.
-/

noncomputable section
open scoped Classical BigOperators NumberField nonZeroDivisors

namespace HeckeSkeleton.Moments.EngineStepV2.Blueprint.T3a

open EngineStep
open NumberField IsDedekindDomain DedekindZetaZeroFree LocalFiniteSums
open UniqueFactorizationMonoid
open HeckeGeneral.Arithmetic HeckeGeneral.Characters HeckeGeneral.Analysis
open HeckeGeneral.Analysis.ConditionalMoments HeckeGeneral.Analysis.ActualSIntegerMoments
open HeckeGeneral.ThetaSkeleton HeckeGeneral.ThetaSkeleton.Global
open HeckeGeneral.ThetaSkeleton.Physical

variable {K : Type} [Field K] [NumberField K]
variable {A : SArithmeticData K}
variable (P : ProbeData K (A.Sf : Set (HeightOneSpectrum (𝓞 K))))
variable (R : RowCharacterInput K (A.Sf : Set (HeightOneSpectrum (𝓞 K))) P)

/-- A singleton's character is the complete character of its original
generated ideal in its own computed sector. -/
theorem singleton_character_complete
    (I : A.Exterior) (a : A.R) (ha : A.Generates I a) :
    let D := OriginalMovingFactors.singleton (P := P) (R := R) ⟨a, ha.1⟩ 1
    D.character = completeIdealRowCharacter K
      (A.Sf : Set (HeightOneSpectrum (𝓞 K))) P R
      (D.decomposition (0 : Fin 1)).2 (HeckeAxiom.exteriorEquiv A I).val := by
  let D := OriginalMovingFactors.singleton (P := P) (R := R) ⟨a, ha.1⟩ 1
  have hI : D.factorIdeal (0 : Fin 1) = I :=
    D.factorIdeal_eq_of_generates (0 : Fin 1) I ha
  have hideal : (D.decomposition (0 : Fin 1)).1 = HeckeAxiom.exteriorEquiv A I := by
    have he := congrArg (HeckeAxiom.exteriorEquiv A) hI
    simpa only [OriginalMovingFactors.factorIdeal, Equiv.apply_symm_apply] using he
  have hchar : D.character = D.factorCharacter (0 : Fin 1) := by
    change (∏ i : Fin 1, D.factorCharacter i ^ (1 : ℤ)) = D.factorCharacter (0 : Fin 1)
    simp only [zpow_one]
    exact Fin.prod_univ_one (fun i : Fin 1 => D.factorCharacter i)
  change D.character = _
  rw [hchar, completeIdealRowCharacter_exterior]
  change R.character (decomposedFrequencyRow K
    (A.Sf : Set (HeightOneSpectrum (𝓞 K))) (D.decomposition (0 : Fin 1)).1
      (D.decomposition (0 : Fin 1)).2) = _
  rw [hideal]

/-- The local calculation reads the full two original ideal counts. -/
theorem singleton_mul_complete_count_dvd_six
    (I J : A.Exterior) (a : A.R) (ha : A.Generates I a)
    (sector : SixthUnitClasses K (A.Sf : Set (HeightOneSpectrum (𝓞 K))))
    (p : HeightOneSpectrum (𝓞 K))
    (hp : p ∉ (A.Sf : Set (HeightOneSpectrum (𝓞 K))))
    (hχ : UnramifiedAt K
      ((OriginalMovingFactors.singleton (P := P) (R := R) ⟨a, ha.1⟩ 1).character *
        completeIdealRowCharacter K (A.Sf : Set (HeightOneSpectrum (𝓞 K)))
          P R sector (HeckeAxiom.exteriorEquiv A J).val) p) :
    6 ∣ (normalizedFactors I.val).count p.asIdeal +
      (normalizedFactors J.val).count p.asIdeal := by
  rw [singleton_character_complete P R I a ha] at hχ
  exact completeRowCharacters_sum_exponent_dvd_six
    (A.Sf : Set (HeightOneSpectrum (𝓞 K))) P R
    (HeckeAxiom.exteriorEquiv A I) (HeckeAxiom.exteriorEquiv A J) _ sector p hp hχ

variable {σ : K →+* ℂ} {η : RayClassCharacter K A.modulus}
variable {hS : A.ContainsTraceBadPlaces}
variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- At the selected actual prime, the active factor has exponent two.
The extraction identity then recovers the original frequency count. -/
theorem secondActive_original_count_dvd_six
    (C : A.GeneralArithmeticContext σ η hS)
    (p : ι → ExteriorPrime A) (hp : Function.Injective p)
    (m n : ι → ℕ) (h : A.R) (Ih Ir : A.Exterior)
    (hextract : Ih.val = gcd (primePowerProduct p m).val (primePowerProduct p n).val *
      (nonunitFrequencyRadical C p m n h).val * Ir.val)
    (sector : SixthUnitClasses K (A.Sf : Set (HeightOneSpectrum (𝓞 K))))
    (i : ι) (hi : i ∈ multiplicityOneNonunitPrimes C p m n h)
    (hχ : UnramifiedAt K
      ((secondOriginalMovingFactors P R C p m n (actualNonunitPattern C p m n h)).character *
        completeIdealRowCharacter K (A.Sf : Set (HeightOneSpectrum (𝓞 K)))
          P R sector (HeckeAxiom.exteriorEquiv A Ir).val) (p i).val) :
    6 ∣ (normalizedFactors Ih.val).count (p i).val.asIdeal := by
  have hsum := singleton_mul_complete_count_dvd_six P R
    (secondActiveFrequencyIdeal p m n (actualNonunitPattern C p m n h)) Ir
    (secondActiveFrequencyGenerator C p m n (actualNonunitPattern C p m n h))
    (secondActiveFrequencyGenerator_generates C p m n (actualNonunitPattern C p m n h))
    sector (p i).val
    ((HeckeAxiom.exteriorEquiv A (primeIdeal (p i))).property (p i).val dvd_rfl) hχ
  have hactive :
      (normalizedFactors (secondActiveFrequencyIdeal p m n
        (actualNonunitPattern C p m n h)).val).count (p i).val.asIdeal = 2 := by
    obtain ⟨hm, hn, hnonunit⟩ := (Finset.mem_filter.mp hi).2
    simp only [hm, hn] at hnonunit
    rw [secondActiveFrequencyIdeal, primePowerProduct_count p hp]
    simp [secondActiveExponent, actualNonunitPattern, hm, hn, hnonunit]
  rw [hactive] at hsum
  rw [multiplicity_one_nonunit_extracted_count C p hp m n h Ih Ir hextract i hi]
  exact hsum

/-- The preceding count statement applies to the row actually chosen
by the second transform; both its residual ideal and sector are fixed. -/
theorem actualSecondRow_original_exponent_dvd_six
    {H : Type*} (C : A.GeneralArithmeticContext σ η hS)
    (Q : ActualSecondCorrelationRows A σ H ι) (h : Q.live)
    (i : ι) (hi : i ∈ multiplicityOneNonunitPrimes C Q.primes
      Q.leftMultiplicity Q.rightMultiplicity (Q.frequency h.val))
    (hχ : UnramifiedAt K
      ((secondOriginalMovingFactors P R C Q.primes Q.leftMultiplicity Q.rightMultiplicity
        (actualNonunitPattern C Q.primes Q.leftMultiplicity Q.rightMultiplicity
          (Q.frequency h.val))).character *
        completeIdealRowCharacter K (A.Sf : Set (HeightOneSpectrum (𝓞 K)))
          P R ((Q.extractedRow C h).sector P) (Q.extractedRow C h).momentIdeal)
      (Q.primes i).val) :
    6 ∣ (normalizedFactors (Q.originalIdeal h.val).val).count (Q.primes i).val.asIdeal :=
  secondActive_original_count_dvd_six P R C Q.primes Q.primes_injective
    Q.leftMultiplicity Q.rightMultiplicity (Q.frequency h.val)
    (Q.originalIdeal h.val) (Q.extractedRow C h).ideal
    (Q.extractedRow_ideal_factor C h) ((Q.extractedRow C h).sector P) i hi hχ

/-- An unramified original prefix can be removed directly on local
units, without asserting that either remaining factor is unramified. -/
theorem unramified_product_of_unramified_prefix
    (preχ χ ψ : HeckeCharacter K) (p : HeightOneSpectrum (𝓞 K))
    (hprefix : UnramifiedAt K preχ p)
    (hfull : UnramifiedAt K (preχ * χ * ψ) p) :
    UnramifiedAt K (χ * ψ) p := by
  intro u hu
  have he := hfull u hu
  change localComponent K p preχ u * localComponent K p χ u *
    localComponent K p ψ u = 1 at he
  rw [hprefix u hu, one_mul] at he
  exact he

end HeckeSkeleton.Moments.EngineStepV2.Blueprint.T3a

#print axioms HeckeSkeleton.Moments.EngineStepV2.Blueprint.T3a.singleton_character_complete
#print axioms HeckeSkeleton.Moments.EngineStepV2.Blueprint.T3a.actualSecondRow_original_exponent_dvd_six
