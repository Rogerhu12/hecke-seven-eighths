import HeckeSkeleton.HighBinSupport.PrimePowerFourier
import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.Algebra.Prime.Lemmas
import Mathlib.Algebra.GroupWithZero.Divisibility
import Lean.Elab.Tactic.Omega
/-!
# Actual principal prime-power quotient support

The ring is literally A/(π^n), not an unspecified finite local ring.
The residue kernel is generated by π. Its annihilator is computed by
cancellation in the domain, and exact valuations give the three Gauss
support regimes. Finiteness and a field structure on A/(π) are needed
only when importing the finite Fourier conclusions.

AI-assisted: ChatGPT / GPT-6 Astra Pro, 2026-10-30.
-/

noncomputable section
namespace HighBin.PrincipalPowerSupport
open HighBin.FiniteResidueFourier HighBin.PrimePowerFourier
open scoped Classical

variable {A : Type*} [CommRing A]

def powerIdeal (π : A) (n : ℕ) : Ideal A := Ideal.span {π ^ n}
abbrev PowerQuotient (π : A) (n : ℕ) := A ⧸ powerIdeal π n

def residueMap (π : A) (n : ℕ) (hn : 1 ≤ n) :
    PowerQuotient π n →+* PowerQuotient π 1 :=
  Ideal.quotientMap (powerIdeal π 1) (RingHom.id A) (by
    intro x hx
    change x ∈ powerIdeal π 1
    apply Ideal.mem_span_singleton.mpr
    exact (pow_dvd_pow π hn).trans (Ideal.mem_span_singleton.mp hx))

@[simp] theorem residueMap_mk (π : A) (n : ℕ) (hn : 1 ≤ n) (x : A) :
    residueMap π n hn (Ideal.Quotient.mk (powerIdeal π n) x) =
      Ideal.Quotient.mk (powerIdeal π 1) x := rfl

theorem residueMap_surjective (π : A) (n : ℕ) (hn : 1 ≤ n) :
    Function.Surjective (residueMap π n hn) :=
  Ideal.quotientMap_surjective Function.surjective_id

@[simp] theorem residueMap_uniformizer (π : A) (n : ℕ) (hn : 1 ≤ n) :
    residueMap π n hn (Ideal.Quotient.mk (powerIdeal π n) π) = 0 := by
  rw [residueMap_mk]
  change Ideal.Quotient.mk (Ideal.span {π ^ 1}) π = 0
  exact (Ideal.Quotient.eq_zero_iff_dvd (π ^ 1) π).mpr
    (by simpa only [pow_one] using (dvd_refl π))

/-- This is the actual kernel computation, without a local-ring axiom. -/
theorem residue_kernel_iff (π : A) (n : ℕ) (hn : 1 ≤ n)
    (x : PowerQuotient π n) :
    residueMap π n hn x = 0 ↔
      ∃ y : PowerQuotient π n, x = Ideal.Quotient.mk (powerIdeal π n) π * y := by
  constructor
  · intro hx
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
    have ha : π ∣ a := by
      rw [residueMap_mk] at hx
      change Ideal.Quotient.mk (Ideal.span {π ^ 1}) a = 0 at hx
      simpa only [pow_one] using (Ideal.Quotient.eq_zero_iff_dvd (π ^ 1) a).mp hx
    obtain ⟨b, hb⟩ := ha
    refine ⟨Ideal.Quotient.mk (powerIdeal π n) b, ?_⟩
    rw [← map_mul, ← hb]
  · rintro ⟨y, hy⟩
    rw [hy, map_mul, residueMap_uniformizer, zero_mul]

/-- Annihilating the whole residue kernel is equivalent to annihilating
its actual generator. -/
theorem kernel_annihilator_iff (π : A) (n : ℕ) (hn : 1 ≤ n)
    (h : PowerQuotient π n) :
    (∀ x : PowerQuotient π n, residueMap π n hn x = 0 → h * x = 0) ↔
      h * Ideal.Quotient.mk (powerIdeal π n) π = 0 := by
  constructor
  · intro hh
    exact hh _ (residueMap_uniformizer π n hn)
  · intro hh x hx
    obtain ⟨y, rfl⟩ := (residue_kernel_iff π n hn x).mp hx
    rw [← mul_assoc, hh, zero_mul]

@[simp] theorem quotient_mk_zero_iff (π : A) (n : ℕ) (h : A) :
    Ideal.Quotient.mk (powerIdeal π n) h = 0 ↔ π ^ n ∣ h :=
  Ideal.Quotient.eq_zero_iff_dvd (π ^ n) h

section Domain
variable [IsDomain A]

/-- Exact support before any valuation notation or Gauss formula. -/
theorem support_mk_iff_dvd (π : A) (hπ : π ≠ 0) (n : ℕ) (hn : 1 ≤ n) (h : A) :
    (∀ x : PowerQuotient π n, residueMap π n hn x = 0 →
      Ideal.Quotient.mk (powerIdeal π n) h * x = 0) ↔ π ^ (n - 1) ∣ h := by
  rw [kernel_annihilator_iff, ← map_mul, quotient_mk_zero_iff]
  have hp : π ^ n = π ^ (n - 1) * π := by
    rw [← pow_succ, Nat.sub_add_cancel hn]
  rw [hp, mul_dvd_mul_iff_right hπ]

/-- Removing a factor prime to π does not change the exact π valuation. -/
theorem valuation_divisibility_iff (π : A) (hπ : Prime π) (v : A)
    (hv : ¬π ∣ v) (n J : ℕ) : π ^ n ∣ π ^ J * v ↔ n ≤ J := by
  constructor
  · intro h
    exact (pow_dvd_pow_iff hπ.ne_zero hπ.not_isUnit).mp
      (hπ.pow_dvd_of_dvd_mul_right n hv h)
  · intro h
    exact dvd_mul_of_dvd_left (pow_dvd_pow π h) v

/-- For h=π^J v, v prime to π, the support condition is exactly n-1≤J. -/
theorem support_exact_valuation (π : A) (hπ : Prime π) (n : ℕ) (hn : 1 ≤ n)
    (v : A) (hv : ¬π ∣ v) (J : ℕ) :
    (∀ x : PowerQuotient π n, residueMap π n hn x = 0 →
      Ideal.Quotient.mk (powerIdeal π n) (π ^ J * v) * x = 0) ↔ n - 1 ≤ J := by
  rw [support_mk_iff_dvd π hπ.ne_zero n hn,
    valuation_divisibility_iff π hπ v hv (n - 1) J]

/-- The zero-frequency boundary is one full valuation later. -/
theorem zero_exact_valuation (π : A) (hπ : Prime π) (n : ℕ)
    (v : A) (hv : ¬π ∣ v) (J : ℕ) :
    Ideal.Quotient.mk (powerIdeal π n) (π ^ J * v) = 0 ↔ n ≤ J := by
  rw [quotient_mk_zero_iff, valuation_divisibility_iff π hπ v hv n J]

/-- Every quotient modulo π^n with n≥2 has a genuinely nonzero residue
kernel. This is the denominator k≥2 cancellation input. -/
theorem residue_kernel_nonzero (π : A) (hπ : Prime π) (n : ℕ) (hn : 2 ≤ n) :
    ∃ x : PowerQuotient π n, residueMap π n (by omega) x = 0 ∧ x ≠ 0 := by
  refine ⟨Ideal.Quotient.mk (powerIdeal π n) π, residueMap_uniformizer _ _ _, ?_⟩
  intro hz
  have hd := (quotient_mk_zero_iff π n π).mp hz
  have hp : π ^ n ∣ π ^ 1 := by simpa only [pow_one] using hd
  have := (pow_dvd_pow_iff hπ.ne_zero hπ.not_isUnit).mp hp
  omega

end Domain

section FiniteFourier
variable [IsDomain A]
variable (π : A) (n : ℕ) (hn : 1 ≤ n)
variable [(powerIdeal π 1).IsMaximal]
local instance : Field (PowerQuotient π 1) := Ideal.Quotient.field (powerIdeal π 1)
variable [Fintype (PowerQuotient π n)] [Fintype (PowerQuotient π 1)]

/-- Literal principal quotient instantiation of the earlier Fourier
support predicate. -/
theorem inFrequencySupport_iff (hπ : Prime π) (v : A) (hv : ¬π ∣ v) (J : ℕ) :
    InFrequencySupport (residueMap π n hn)
      (Ideal.Quotient.mk (powerIdeal π n) (π ^ J * v)) ↔ n - 1 ≤ J :=
  support_exact_valuation π hπ n hn v hv J

/-- Every pulled-back residue function vanishes at frequencies strictly
below the active valuation, proved on the actual quotient A/(π^n). -/
theorem fourier_vanishes_below (hπ : Prime π) (v : A) (hv : ¬π ∣ v) (J : ℕ)
    (hJ : J < n - 1) (ψ : AddChar (PowerQuotient π n) ℂ)
    (hψ : ψ.IsPrimitive) (f : PowerQuotient π 1 → ℂ) :
    HighBin.FiniteResidueFourier.fourier ψ (fun x => f (residueMap π n hn x))
      (Ideal.Quotient.mk (powerIdeal π n) (π ^ J * v)) = 0 := by
  apply fourier_eq_zero_of_not_supported (residueMap π n hn) ψ hψ f
  rw [inFrequencySupport_iff π n hn hπ v hv J]
  omega

/-- The principal character on the active boundary is minus the literal
residue-kernel cardinality, with no valuation table assumed. -/
theorem principal_active_value (hπ : Prime π) (v : A) (hv : ¬π ∣ v)
    (ψ : AddChar (PowerQuotient π n) ℂ) (hψ : ψ.IsPrimitive) :
    HighBin.FiniteResidueFourier.fourier ψ
      (fun x => (1 : MulChar (PowerQuotient π 1) ℂ) (residueMap π n hn x))
      (Ideal.Quotient.mk (powerIdeal π n) (π ^ (n - 1) * v)) =
        -(Nat.card {x : PowerQuotient π n // residueMap π n hn x = 0} : ℂ) := by
  apply principal_nonzero_active (residueMap π n hn) (residueMap_surjective π n hn) ψ hψ
  · exact (inFrequencySupport_iff π n hn hπ v hv (n - 1)).mpr le_rfl
  · intro hz
    have hd := (zero_exact_valuation π hπ n v hv (n - 1)).mp hz
    omega

/-- A nonprincipal character vanishes throughout the zero-frequency
range J≥n, as the actual finite sum. -/
theorem nonprincipal_zero_range (hπ : Prime π) (v : A) (hv : ¬π ∣ v) (J : ℕ)
    (hJ : n ≤ J) (ψ : AddChar (PowerQuotient π n) ℂ)
    (χ : MulChar (PowerQuotient π 1) ℂ) (hχ : χ ≠ 1) :
    HighBin.FiniteResidueFourier.fourier ψ (fun x => χ (residueMap π n hn x))
      (Ideal.Quotient.mk (powerIdeal π n) (π ^ J * v)) = 0 := by
  rw [(zero_exact_valuation π hπ n v hv J).mpr hJ]
  exact nonprincipal_zero (residueMap π n hn) (residueMap_surjective π n hn) ψ χ hχ

/-- Exact multiplicity follows from the known actual quotient norm.
The cardinality premise is a separate ideal-norm fact, not a Gauss sum
or Fourier evaluation. -/
theorem residue_kernel_card
    (hc : Fintype.card (PowerQuotient π n) = Fintype.card (PowerQuotient π 1) ^ n) :
    Nat.card {x : PowerQuotient π n // residueMap π n hn x = 0} =
      Fintype.card (PowerQuotient π 1) ^ (n - 1) := by
  have he := Nat.card_congr
    (residueKernelEquiv (residueMap π n hn) (residueMap_surjective π n hn))
  rw [Nat.card_prod, Nat.card_eq_fintype_card (α := PowerQuotient π n),
    Nat.card_eq_fintype_card (α := PowerQuotient π 1), hc] at he
  have hn' : n = (n - 1) + 1 := by omega
  have hpow : Fintype.card (PowerQuotient π 1) ^ n =
      Fintype.card (PowerQuotient π 1) * Fintype.card (PowerQuotient π 1) ^ (n - 1) := by
    conv_lhs => rw [hn', pow_succ, mul_comm]
  rw [hpow] at he
  exact Nat.eq_of_mul_eq_mul_left Fintype.card_pos he.symm

#print axioms support_exact_valuation
#print axioms zero_exact_valuation
#print axioms residue_kernel_nonzero
#print axioms fourier_vanishes_below
#print axioms principal_active_value
#print axioms residue_kernel_card

end FiniteFourier
end HighBin.PrincipalPowerSupport
